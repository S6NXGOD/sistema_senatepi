// ============================================================================
// SENATEPI — Schema Prisma
// Sindicato dos Enfermeiros, Auxiliares e Técnicos em Enfermagem do Piauí
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  ADMINISTRADOR // Acesso completo a todos os módulos e configurações
  COORDENACAO // Gestão de equipe, financeiro e relatórios gerenciais
  ADVOGADO // Processos, agenda de prazos e acompanhamento jurídico
  TRIAGEM // Atendimento inicial de filiados e registro de demandas
}

enum Sexo {
  MASCULINO
  FEMININO
  OUTRO
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
  OUTRO
}

/// Vínculo do filiado com o EMPREGADOR — não confundir com `SituacaoFiliado`,
/// que é o vínculo dele com o SINDICATO.
///
/// São duas coisas distintas: um aposentado pode (e costuma) seguir filiado e
/// em dia; um servidor na ativa pode estar desfiliado. Guardar as duas no mesmo
/// campo obrigaria a escolher qual verdade contar.
///
/// Universal o bastante para ser enum: serve tanto a servidor público quanto a
/// celetista. Nulo em quem não informou.
enum VinculoFuncional {
  ATIVO
  APOSENTADO
  PENSIONISTA
}

enum SituacaoFiliado {
  ATIVO
  INATIVO
  DESFILIADO // desligado do sindicato — perde acesso a eventos e benefícios (colônia)
}

// StatusGenerico, TipoFuncionario, StatusFuncionario e TipoHistoricoFuncionario
// saíram com a unificação: quem descreve a equipe agora é StatusColaborador /
// TipoVinculo / TipoHistoricoColaborador.

enum TipoHistoricoFiliado {
  FILIACAO
  ALTERACAO
  RECADASTRAMENTO
  MUDANCA_STATUS
  INCLUSAO_DEPENDENTE
  EXCLUSAO_DEPENDENTE
  UPLOAD_DOCUMENTO
  GERACAO_CARTEIRINHA
  GERACAO_TERMO
}

enum TipoDependente {
  CONJUGE
  FILHO
  /// Pai e mãe entram como dependentes em sindicatos que estendem benefícios
  /// (clube, convênios) à família de origem. Sem limite de idade, ao contrário
  /// de FILHO — ver `dependenteValidoParaEvento`.
  PAI
  MAE
}

enum FormacaoProfissional {
  ENFERMEIRO
  TECNICO_ENFERMAGEM
  AUXILIAR_ENFERMAGEM
  OUTRO
}

/// Quem pode ter presença registrada num evento.
/// FUNCIONARIO e PRESTADOR viraram COLABORADOR — cadastro único da equipe.
enum TipoPessoa {
  FILIADO
  DEPENDENTE
  COLABORADOR
}

/// Tipo do evento — é RÓTULO, não comportamento.
///
/// O que liga votação, certificado ou exigência de adimplência é
/// `Evento.configuracoes`, não este enum. Um congresso pode ter votação e uma
/// assembleia pode sortear um brinde; amarrar comportamento ao tipo obrigaria a
/// um novo tipo a cada combinação.
enum TipoEvento {
  ASSEMBLEIA
  CONGRESSO
  REUNIAO
  CURSO
  SORTEIO
  NEGOCIACAO
  EVENTO_SOCIAL
  EVENTO_ESPORTIVO
  OUTRO
}

enum StatusEvento {
  AGENDADO
  EM_ANDAMENTO
  REALIZADO
  CANCELADO
}

enum StatusCarteirinha {
  ATIVA
  EXPIRADA
  REVOGADA
}

enum TipoDocumento {
  TERMO_CONSENTIMENTO
  FICHA_FILIACAO
  /// Termo de desfiliação assinado pelo filiado — arquivado na aba Documentos.
  TERMO_DESFILIACAO
  CONTRATO
  DOCUMENTO_PESSOAL
  OUTRO
}

/// Como o filiado contribui com o sindicato.
///
/// DESCONTO_FOLHA aponta para os locais de trabalho com `descontoEmFolha` — é lá
/// que se sabe EM QUAL folha o desconto acontece (quem tem duplo vínculo
/// costuma ter desconto em um só).
enum ModalidadeContribuicao {
  DESCONTO_FOLHA
  AVULSO // PIX / boleto
  PENSIONISTA
}

/// Por que o filiado saiu do quadro associativo.
///
/// Lista fechada de propósito: o motivo em texto livre não permitia responder
/// "quantos saíram por inadimplência este ano?", que é a pergunta que a
/// diretoria faz. A observação livre continua existindo ao lado.
enum MotivoDesfiliacao {
  APOSENTADORIA
  MUDANCA_ESTADO
  MUDANCA_PROFISSAO
  SOLICITACAO_PESSOAL
  INADIMPLENCIA
  OUTROS
}

enum AcaoAuditoria {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  VALIDACAO_QR
  EXPORT
  IMPORT
}

enum StatusImportacao {
  VALIDANDO
  VALIDADO
  IMPORTANDO
  CONCLUIDO
  ERRO
}

enum EstrategiaDuplicado {
  IGNORAR
  ATUALIZAR
}

enum EstrategiaMatricula {
  REGENERAR // gera uma matrícula nova quando a do arquivo colide
  DISPENSAR // não importa a pessoa quando a matrícula colide
}

/// QUAL PLANILHA está sendo importada — o layout muda o que cada coluna
/// significa e, principalmente, COMO SE RECONHECE A PESSOA.
///
/// Não é preciosismo: no CSV legado a âncora de identidade é o CPF; na folha da
/// Prefeitura NÃO EXISTE CPF, e a âncora passa a ser o par órgão + matrícula.
/// Um único fluxo tentando adivinhar qual dos dois vale acabaria casando gente
/// errada — que é o erro que este módulo inteiro existe para não cometer.
enum PerfilImportacao {
  /// Base do sistema antigo, com CPF, endereço, formação. Fluxo original.
  LEGADO_CSV
  /// Folha enviada pela Prefeitura: Órgão, Matrícula, Nome, Quadro, Lotação,
  /// Cargo (e Valor, que é descartado na leitura).
  FOLHA_PREFEITURA
}

/// O QUE A PRÉVIA DECIDIU sobre cada linha, antes de qualquer escrita.
///
/// É o vocabulário da tela de conferência. `CONFLITO` é o estado mais
/// importante: significa "há um candidato, mas casar por conta própria seria
/// chute" — e nada acontece com ele até uma pessoa decidir.
enum ClassificacaoLinha {
  /// Ninguém no sistema tem esta matrícula neste órgão, nem nome parecido.
  NOVO
  /// Achou o vínculo exato (órgão + matrícula). Atualiza cargo/lotação/quadro.
  ATUALIZACAO
  /// Achou candidato, mas a identidade não é certa — espera decisão humana.
  CONFLITO
  /// A mesma matrícula aparece mais de uma vez NO ARQUIVO.
  DUPLICIDADE
  /// Linha inválida (sem nome, sem matrícula...). Não entra de jeito nenhum.
  ERRO
}

/// POR QUE a linha ficou em conflito. O motivo muda o que se pergunta ao
/// operador, então é dado, não texto solto.
///
/// NÃO existe "órgão divergente" aqui, e a ausência é uma decisão: na
/// Prefeitura de Teresina a matrícula é única no município, então a mesma
/// matrícula em outra secretaria é a MESMA pessoa que foi transferida — isso é
/// atualização do vínculo, não conflito. Tratar transferência como conflito
/// mandaria centenas de servidores para uma fila de decisão manual sem que
/// houvesse dúvida nenhuma a resolver.
enum MotivoConflito {
  /// Nome igual ao de um cadastro existente, mas a matrícula é nova. Pode ser
  /// segundo vínculo da MESMA pessoa — ou um homônimo.
  NOME_SEMELHANTE
  /// O nome da planilha não bate com o nome de quem tem essa matrícula.
  /// Matrícula reaproveitada, erro de digitação na origem, ou casamento.
  NOME_DIVERGENTE
  /// Matrícula igual, CPF diferente. Só o export do banco legado traz CPF; um
  /// dos dois documentos está errado e o sistema não tem como saber qual.
  CPF_DIVERGENTE
}

/// O que o operador respondeu num conflito. Enquanto for `PENDENTE`, a linha
/// não é importada — silêncio nunca vira ação.
enum DecisaoConflito {
  PENDENTE
  /// "É a mesma pessoa": anexa o vínculo ao cadastro apontado.
  MESMA_PESSOA
  /// "São pessoas diferentes": cria cadastro novo.
  PESSOA_DIFERENTE
  /// "Deixa para depois": não importa esta linha.
  IGNORAR
}

enum StatusRecadastramento {
  PENDENTE
  APROVADO
  REJEITADO
}

/// Como o filiado prova que é ele ao abrir o link de recadastramento.
enum DesafioRecadastramento {
  CPF_NASCIMENTO // padrão: confirma CPF + data de nascimento
  COREN // quando não há CPF/nascimento no cadastro, mas há COREN
  NENHUM // cadastro sem CPF, sem nascimento e sem COREN — link direto
}

/// Link de recadastramento ONLINE enviado ao filiado.
///
/// Segurança: o token NUNCA é guardado em claro — só o hash (mesmo padrão de
/// RefreshToken/PasswordReset). O link vale 24h, é de USO ÚNICO e trava após
/// algumas tentativas erradas no desafio (evita adivinhar CPF/nascimento).
model LinkRecadastramento {
  id             String                 @id @default(uuid())
  filiadoId      String                 @map("filiado_id")
  tokenHash      String                 @unique @map("token_hash")
  desafio        DesafioRecadastramento
  expiraEm       DateTime               @map("expira_em")
  usadoEm        DateTime?              @map("usado_em")
  revogadoEm     DateTime?              @map("revogado_em")
  /// Tentativas erradas no desafio (trava em 5).
  tentativas     Int                    @default(0)
  criadoPor      String?                @map("criado_por")
  ipUltimoAcesso String?                @map("ip_ultimo_acesso")
  createdAt      DateTime               @default(now()) @map("created_at")

  filiado Filiado @relation(fields: [filiadoId], references: [id], onDelete: Cascade)

  @@index([filiadoId])
  @@index([expiraEm])
  @@map("links_recadastramento")
}

// ============================================================================
// AUTENTICAÇÃO E USUÁRIOS
// ============================================================================

model User {
  id                 String    @id @default(uuid())
  nome               String
  nomeExibicao       String?   @map("nome_exibicao") // nome curto exibido na interface
  email              String    @unique
  username           String?   @unique // nome de usuário opcional
  senhaHash          String    @map("senha_hash")
  avatarUrl          String?   @map("avatar_url") // foto de perfil (URL informada manualmente)
  avatarKey          String?   @map("avatar_key") // chave no storage quando a foto é enviada (upload)
  /// Inscrição na OAB (só dígitos) — chave do cruzamento com os advogados que o
  /// tribunal informa no processo, além de dado de perfil do próprio advogado.
  oab                String?
  oabUf              String?   @map("oab_uf") // UF da inscrição (ex.: PI)
  role               UserRole  @default(TRIAGEM)
  // Matriz de permissões por módulo (override do preset do perfil): { "processos": "EDITAR", ... }
  permissoes         Json?
  ativo              Boolean   @default(true)
  ultimoLoginEm      DateTime? @map("ultimo_login_em")
  /// CORTE DE SESSÃO: todo token de acesso emitido ANTES deste instante é
  /// recusado.
  ///
  /// Existe porque apagar os refresh tokens não desloga ninguém: o token de
  /// acesso é um JWT autocontido, válido por 30 dias, e continua sendo aceito
  /// até expirar sozinho. Sem este corte, tirar alguém de um aparelho
  /// emprestado — ou encerrar uma demonstração feita com a conta
  /// administrativa — dependeria de esperar um mês.
  ///
  /// Preenchido pelo script `forcar-logout` (ver prisma/scripts). Nulo = nunca
  /// houve corte.
  sessoesValidasApos DateTime? @map("sessoes_validas_apos")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  refreshTokens           RefreshToken[]
  auditorias              Auditoria[]
  recadastramentos        Recadastramento[]      @relation("RecadastramentoRevisor")
  atendimentos            Atendimento[]
  compromissos            Compromisso[]          @relation("CompromissoResponsavel")
  /// Eventos que este usuário REGISTROU (≠ dos que ele é responsável).
  compromissosCriados     Compromisso[]          @relation("CompromissoCriador")
  processos               Processo[]             @relation("ProcessoAdvogado")
  /// Processos em que atua (N:N) — inclui os que responde como principal.
  processosEquipe         ProcessoAdvogado[]     @relation("ProcessoAdvogadoEquipe")
  escalas                 EscalaAdvogado[]
  movimentacoesInternas   MovimentacaoInterna[]  @relation("MovimentacaoAutor")
  contribuicoesAnalisadas ContribuicaoPatronal[] @relation("ContribuicaoAnalista")
  compromissosHistorico   CompromissoHistorico[] @relation("CompromissoHistoricoAutor")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiraEm  DateTime @map("expira_em")
  revogado  Boolean  @default(false)
  userAgent String?  @map("user_agent")
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  email     String
  tokenHash String   @map("token_hash")
  expiraEm  DateTime @map("expira_em")
  usado     Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("password_resets")
}

// ============================================================================
// FILIADOS
// ============================================================================

model Filiado {
  id                 String                @id @default(uuid())
  matricula          String                @unique // matrícula sindical
  // Dados pessoais
  nomeCompleto       String                @map("nome_completo")
  cpf                String?               @unique
  rg                 String?
  ufRg               String?               @map("uf_rg")
  dataNascimento     DateTime?             @map("data_nascimento")
  sexo               Sexo?
  estadoCivil        EstadoCivil?          @map("estado_civil")
  naturalidade       String?
  fotoKey            String?               @map("foto_key") // chave no storage (original webp)
  fotoThumbKey       String?               @map("foto_thumb_key") // chave do thumbnail
  // Contato
  telefonePrincipal  String?               @map("telefone_principal")
  telefoneSecundario String?               @map("telefone_secundario")
  email              String?
  // Endereço
  cep                String?
  endereco           String?
  numero             String?
  complemento        String?
  bairro             String?
  cidade             String?
  estado             String?
  // Dados profissionais
  formacao           FormacaoProfissional?
  formacaoOutro      String?               @map("formacao_outro") // texto livre quando formacao = OUTRO
  numeroCoren        String?               @map("numero_coren")
  /// SOMENTE LEITURA — mantidas por gatilho no banco (trg_filiados_busca).
  /// Guardam nome/matrícula/COREN/CPF e cidade já em minúsculo, sem acento e
  /// com pontuação virada em espaço, para a busca ignorar acento e ordem das
  /// palavras. NUNCA escreva nelas pela aplicação: o gatilho sobrescreve a
  /// cada INSERT/UPDATE dos campos de origem.
  buscaNormalizada   String?               @map("busca_normalizada")
  cidadeNormalizada  String?               @map("cidade_normalizada")
  dataAdmissao       DateTime?             @map("data_admissao")
  /// Vínculo com o EMPREGADOR (ativo/aposentado/pensionista). Diferente de
  /// `situacao`, que é o vínculo com o SINDICATO — ver o enum.
  vinculoFuncional   VinculoFuncional?     @map("vinculo_funcional")
  // Situação
  situacao           SituacaoFiliado       @default(ATIVO)
  aprovadoEm         DateTime?             @map("aprovado_em")

  /// DATA DE FILIAÇÃO — quando a pessoa entrou no quadro associativo.
  ///
  /// Campo próprio porque `createdAt` acumulava dois significados: a importação
  /// legada gravava nele a data de filiação da planilha, e o cadastro pelo
  /// sistema gravava a data do registro. Quando a planilha vinha SEM a data,
  /// 1.903 pessoas ficaram carimbadas com o dia da carga — e o gráfico de
  /// crescimento mostrava um pico de 1.903 filiações num único mês.
  ///
  /// NULO = data desconhecida (veio da carga sem a informação). Nulo é a
  /// resposta honesta; inventar uma data seria pior, e esses registros ficam
  /// FORA da série temporal em vez de distorcê-la.
  dataFiliacao DateTime? @map("data_filiacao")

  /// Como este filiado contribui. Opcional: a base histórica não tem esse dado,
  /// e exigi-lo retroativamente travaria a edição de 7 mil cadastros.
  modalidadeContribuicao ModalidadeContribuicao? @map("modalidade_contribuicao")

  // ---- Desfiliação -------------------------------------------------------
  // Preenchidos ao desfiliar e PRESERVADOS na reativação: são o registro de que
  // a saída aconteceu e por quê. Sem eles, reativar um filiado apagaria a
  // história — e o financeiro perderia a referência do mês de corte.
  /// Motivo padronizado (o que vira estatística).
  motivoDesfiliacao      MotivoDesfiliacao? @map("motivo_desfiliacao")
  /// Complemento livre do motivo, quando a categoria não basta.
  desfiliacaoObservacoes String?            @map("desfiliacao_observacoes")
  /// Data do pedido de desfiliação (o carimbo de quando a saída foi formalizada).
  desfiliadoEm           DateTime?          @map("desfiliado_em")
  /// Nome de quem executou a desfiliação — snapshot, sobrevive à exclusão do usuário.
  desfiliadoPor          String?            @map("desfiliado_por")
  /// Última mensalidade a cobrar, em 'AAAA-MM'. É o que a folha/financeiro usa
  /// para saber até quando descontar. Texto e não data: o dado é o MÊS, e um
  /// DateTime obrigaria a inventar um dia.
  desfiliacaoMesCorte    String?            @map("desfiliacao_mes_corte")
  // Identificação para QR Code
  qrToken                String             @unique @map("qr_token")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  vinculos             VinculoProfissional[]
  dependentes          Dependente[]
  cobrancas            Cobranca[]
  atendimentos         Atendimento[]
  compromissos         Compromisso[]
  processos            Processo[]
  /// Processos em que o filiado figura como parte (N:N) — um processo pode ter
  /// vários filiados (ação coletiva/plúrima) e um filiado, vários processos.
  partesProcesso       ParteProcesso[]
  carteirinha          Carteirinha?
  documentos           Documento[]
  presencas            Presenca[]
  recadastramentos     Recadastramento[]
  linksRecadastramento LinkRecadastramento[]
  historico            FiliadoHistorico[]
  registrosAcesso      RegistroAcesso[]

  @@index([situacao])
  @@index([cpf])
  @@map("filiados")
}

model FiliadoHistorico {
  id        String               @id @default(uuid())
  filiadoId String               @map("filiado_id")
  tipo      TipoHistoricoFiliado
  descricao String
  autor     String?
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at")

  filiado Filiado @relation(fields: [filiadoId], references: [id], onDelete: Cascade)

  @@index([filiadoId])
  @@map("filiado_historico")
}

/// LOCAL DE TRABALHO do filiado. Um filiado pode ter vários — duplo vínculo é a
/// regra na enfermagem, não a exceção.
model VinculoProfissional {
  id        String @id @default(uuid())
  filiadoId String @map("filiado_id")

  /// Nome do empregador COMO CONSTA no cadastro — snapshot sempre preenchido.
  /// Continua texto de propósito: exigir que todo empregador exista previamente
  /// no cadastro travaria o atendimento no balcão por causa de um hospital novo.
  empresa String

  /// Empregador no cadastro de organizações (`ParteExterna`), quando escolhido
  /// pelo combobox. É o que permite perguntar "quantos filiados trabalham na
  /// FMS?" — e cruzar com "quantos processos temos contra a FMS?", já que o
  /// empregador e o réu costumam ser a MESMA entidade. Nulo = digitado à mão.
  parteExternaId String? @map("parte_externa_id")

  cargo     String?
  /// Onde a pessoa trabalha DENTRO do órgão — secretaria, unidade, setor.
  /// `empresa` é o empregador; num sindicato de servidores é pela lotação
  /// que a base se organiza.
  lotacao   String?
  matricula String? // matrícula na instituição

  /// QUADRO funcional — efetivo, comissionado, contrato temporário, inativo.
  ///
  /// Texto livre, e não enum, porque a nomenclatura é de quem emite a folha:
  /// a Prefeitura de Teresina manda "EFETIVO"/"COMISSIONADO"/"CONTRATO", e o
  /// próximo cliente mandará outra coisa. Um enum obrigaria a uma migration a
  /// cada palavra nova numa planilha que não controlamos — e, pior, obrigaria
  /// a DESCARTAR o que não coubesse. Texto guarda o que veio.
  quadro String?

  /// A MATRÍCULA EM FORMA COMPARÁVEL — maiúsculas, sem espaço, sem zeros à
  /// esquerda ('0012345' e '12345' são a mesma matrícula; o Excel come o zero
  /// sozinho conforme a coluna saia como texto ou como número).
  ///
  /// É por ela que a importação da folha reconhece uma pessoa, já que a
  /// planilha da Prefeitura não traz CPF. Coluna, e não expressão na consulta,
  /// para dar índice e deixar a regra visível no banco.
  ///
  /// NULA quando o vínculo não tem matrícula — cadastro de balcão não precisa
  /// de chave. O índice é PARCIAL justamente por isso.
  ///
  /// ATENÇÃO AO QUE ESTA COLUNA **NÃO** GARANTE: unicidade global. Na
  /// Prefeitura de Teresina a matrícula é única no município inteiro, e ali o
  /// índice único nasce (ver a migration). Num sindicato com muitos
  /// empregadores — o SENATEPI tem hospitais que reaproveitam numeração — dois
  /// vínculos podem legitimamente ter a matrícula '123', e lá o índice único
  /// não é criado. A regra "matrícula identifica a pessoa" é da folha da
  /// Prefeitura e mora no importador dela, não no schema.
  matriculaNormalizada String? @map("matricula_normalizada")

  /// A mensalidade sindical é descontada NA FOLHA DESTE local.
  /// Fica no vínculo, e não no filiado, porque quem tem dois empregos costuma
  /// ter desconto em um só — e o financeiro precisa saber em qual.
  descontoEmFolha Boolean @default(false) @map("desconto_em_folha")

  ordem     Int      @default(1) // 1 = instituição 1, 2 = instituição 2
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  filiado      Filiado       @relation(fields: [filiadoId], references: [id], onDelete: Cascade)
  /// SetNull: apagar a organização não pode apagar o vínculo — `empresa`
  /// (o snapshot) continua respondendo onde a pessoa trabalha.
  parteExterna ParteExterna? @relation(fields: [parteExternaId], references: [id], onDelete: SetNull)

  @@index([filiadoId])
  @@index([parteExternaId])
  /// Lookup da importação: "quem tem esta matrícula?". É a pergunta que
  /// reconhece o servidor mesmo depois de ele mudar de secretaria.
  /// A unicidade, onde couber, vem de índice PARCIAL criado na migration —
  /// o Prisma não sabe declarar índice parcial.
  @@index([matriculaNormalizada])
  @@map("vinculos_profissionais")
}

// ============================================================================
// DEPENDENTES
// ============================================================================

model Dependente {
  id             String         @id @default(uuid())
  filiadoId      String         @map("filiado_id")
  tipo           TipoDependente
  nome           String
  cpf            String?
  dataNascimento DateTime       @map("data_nascimento")
  fotoKey        String?        @map("foto_key")
  fotoThumbKey   String?        @map("foto_thumb_key")
  qrToken        String         @unique @map("qr_token")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  filiado         Filiado          @relation(fields: [filiadoId], references: [id], onDelete: Cascade)
  presencas       Presenca[]
  registrosAcesso RegistroAcesso[]

  @@index([filiadoId])
  @@map("dependentes")
}

// (FUNCIONÁRIOS e PRESTADORES foram unificados em Colaborador — ver o modelo.
//  Prestador pessoa jurídica virou Empresa, no módulo Patronal.)

// ============================================================================
// EVENTOS E CONTROLE DE PRESENÇA
// ============================================================================

/// Evento — o "motor camaleão".
///
/// O MESMO model atende assembleia com votação, curso com certificado e sorteio
/// ao vivo. O que muda o comportamento é `configuracoes`, não o tipo: um
/// congresso pode ter votação, uma assembleia pode ter sorteio de brinde, e
/// exigir adimplência é decisão de cada evento. Três models paralelos
/// (Assembleia, Curso, Sorteio) duplicariam presença, check-in e dossiê — e
/// divergiriam no primeiro ajuste feito só num deles.
model Evento {
  id               String       @id @default(uuid())
  nome             String
  descricao        String?
  local            String?
  dataInicio       DateTime     @map("data_inicio")
  dataFim          DateTime?    @map("data_fim")
  capacidadeMaxima Int?         @map("capacidade_maxima")
  tipo             TipoEvento   @default(OUTRO)
  status           StatusEvento @default(AGENDADO)

  /// Chaves que ligam/desligam o comportamento — ver `configuracoes-evento.ts`,
  /// que é o contrato tipado deste JSON. NUNCA leia este campo direto: passe
  /// pelo parser de lá, senão uma chave escrita errada vira silêncio.
  configuracoes Json @default("{}")

  /// Link da videoconferência (Meet, Zoom, Teams). Colado à mão ou preenchido
  /// pela integração com o Google Calendar, quando configurada.
  linkReuniao   String? @map("link_reuniao")
  /// Id do evento no Google Calendar — só existe quando foi criado por lá.
  /// Guardado para poder atualizar/cancelar o mesmo evento em vez de duplicar.
  googleEventId String? @map("google_event_id")

  /// ---- Fechamento (o "cartório") ----
  /// Gravação da reunião. Mora no Drive de propósito: vídeo de assembleia tem
  /// gigabytes, e o disco do container é efêmero.
  urlVideoDrive  String?   @map("url_video_drive")
  /// Ata em texto. A transcrição é ligada pelo host DENTRO do Meet e cai no
  /// Drive; o sistema não transcreve nada, apenas recebe e arquiva.
  textoAta       String?   @map("texto_ata")
  dossiePdfKey   String?   @map("dossie_pdf_key")
  dossieGeradoEm DateTime? @map("dossie_gerado_em")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  presencas Presenca[]
  pautas    PautaVotacao[]
  sorteios  SorteioEvento[]

  @@index([status])
  @@index([dataInicio])
  @@map("eventos")
}

model Presenca {
  id            String     @id @default(uuid())
  eventoId      String     @map("evento_id")
  tipoPessoa    TipoPessoa @map("tipo_pessoa")
  // Apenas um destes FKs estará preenchido, conforme o tipo de pessoa.
  // `funcionario_id`/`prestador_id` saíram na unificação: a equipe do sindicato
  // entra como COLABORADOR, cadastro único (ver [Colaborador]).
  filiadoId     String?    @map("filiado_id")
  dependenteId  String?    @map("dependente_id")
  colaboradorId String?    @map("colaborador_id")
  registradoEm  DateTime   @default(now()) @map("registrado_em")
  // Snapshot para histórico (mesmo se o cadastro for alterado/removido)
  nomeSnapshot  String     @map("nome_snapshot")

  /// ---- Evidências de acesso (check-in remoto) ----
  ///
  /// NÃO é assinatura digital. Não há certificado ICP-Brasil nem chave privada
  /// do signatário: isto prova que ALGUÉM, de posse daquele CPF, acessou
  /// daquele IP naquele instante, com o vínculo associativo conferido na hora.
  /// É evidência forte de participação — e chamar de "assinatura" atribuiria
  /// ao dossiê um valor probatório que ele não tem.
  ///
  /// LGPD: IP é dado pessoal. A coleta é avisada ANTES, na tela de check-in.
  origem       OrigemPresenca @default(QR_PRESENCIAL)
  ip           String?
  userAgent    String?        @map("user_agent")
  /// CPF exatamente como digitado, para o dossiê registrar o que foi informado.
  cpfInformado String?        @map("cpf_informado")

  evento      Evento       @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  filiado     Filiado?     @relation(fields: [filiadoId], references: [id], onDelete: SetNull)
  dependente  Dependente?  @relation(fields: [dependenteId], references: [id], onDelete: SetNull)
  colaborador Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)

  // Evita entrada duplicada da mesma pessoa no mesmo evento
  @@unique([eventoId, filiadoId])
  @@unique([eventoId, dependenteId])
  @@unique([eventoId, colaboradorId])
  @@index([eventoId])
  @@map("presencas")
}

// ============================================================================
// PLENÁRIO VIRTUAL — pautas, votação e sorteio
// ============================================================================

/// Pauta submetida à votação numa assembleia.
model PautaVotacao {
  id        String  @id @default(uuid())
  eventoId  String  @map("evento_id")
  ordem     Int     @default(0)
  titulo    String
  descricao String?

  /// Opções da cédula: `[{ "id": "sim", "rotulo": "Aprovo" }, ...]`.
  /// JSON porque a quantidade e o texto variam a cada pauta; o `id` é o que
  /// `VotoUrna.opcaoId` referencia.
  opcoes Json

  modo   ModoVotacao @default(SECRETA)
  status StatusPauta @default(RASCUNHO)

  /// Mínimo de votantes para a deliberação valer. Nulo = sem exigência.
  quorumMinimo Int?      @map("quorum_minimo")
  abertaEm     DateTime? @map("aberta_em")
  encerradaEm  DateTime? @map("encerrada_em")
  /// Quem abriu/encerrou — snapshot, sobrevive à exclusão do usuário.
  autor        String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  evento       Evento            @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  habilitacoes VotoHabilitacao[]
  votos        VotoUrna[]

  @@index([eventoId, ordem])
  @@map("pautas_votacao")
}

/// Registro de QUE o filiado votou — não DE QUE FORMA.
///
/// É esta tabela, e só ela, que impede o voto duplo: o índice único abaixo é a
/// trava. Conferir com um SELECT antes de inserir perderia a corrida entre dois
/// cliques simultâneos; deixar o banco recusar é o que torna a garantia real.
///
/// Serve também para apurar quórum e comparecimento sem tocar na urna.
model VotoHabilitacao {
  id        String   @id @default(uuid())
  pautaId   String   @map("pauta_id")
  filiadoId String   @map("filiado_id")
  createdAt DateTime @default(now()) @map("created_at")

  pauta PautaVotacao @relation(fields: [pautaId], references: [id], onDelete: Cascade)

  @@unique([pautaId, filiadoId], map: "voto_habilitacao_unico")
  @@index([pautaId])
  @@map("votos_habilitacao")
}

/// A urna: O QUE foi votado.
///
/// SIGILO — a razão de existirem duas tabelas.
/// Em pauta SECRETA, `filiadoId` fica NULO e NÃO HÁ `createdAt`. A ausência do
/// carimbo de tempo é deliberada: com ele, bastaria ordenar esta tabela e
/// `votos_habilitacao` por horário para parear voto e votante, e o sigilo seria
/// decorativo. Sem timestamp e com id aleatório, não há como correlacionar as
/// duas — nem com acesso direto ao banco.
///
/// Em pauta NOMINAL o `filiadoId` é gravado, porque a ata precisa registrar o
/// voto de cada presente. É escolha por pauta, feita antes de abrir a votação.
model VotoUrna {
  id        String  @id @default(uuid())
  pautaId   String  @map("pauta_id")
  /// `id` da opção escolhida, conforme `PautaVotacao.opcoes`.
  opcaoId   String  @map("opcao_id")
  /// SOMENTE em pauta NOMINAL. Nulo é o que garante o sigilo.
  filiadoId String? @map("filiado_id")

  pauta PautaVotacao @relation(fields: [pautaId], references: [id], onDelete: Cascade)

  @@index([pautaId])
  @@map("votos_urna")
}

/// Sorteio realizado durante um evento.
model SorteioEvento {
  id       String  @id @default(uuid())
  eventoId String  @map("evento_id")
  titulo   String
  premio   String?

  /// Quem concorria: `{ "somentePresentes": true, "somenteAdimplentes": false }`.
  criterio Json @default("{}")

  /// Semente do sorteio, guardada para ele ser REEXECUTÁVEL e conferível.
  /// Sorteio que ninguém pode auditar é sorteio que ninguém precisa acreditar.
  seed String

  /// Resultado: `[{ "filiadoId", "nome", "matricula", "posicao" }]`.
  resultado Json

  realizadoEm DateTime @default(now()) @map("realizado_em")
  autor       String?

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId])
  @@map("sorteios_evento")
}

enum ModoVotacao {
  /// Não há como saber quem votou o quê — nem com acesso ao banco.
  SECRETA
  /// O voto de cada presente fica registrado, para constar em ata.
  NOMINAL
}

enum StatusPauta {
  RASCUNHO
  ABERTA
  ENCERRADA
}

/// Como a pessoa foi identificada na portaria.
enum OrigemAcesso {
  /// Leitura do QR da carteirinha (o caminho normal).
  QR
  /// Digitada a matrícula — do sindicato ou a funcional do empregador.
  MATRICULA
  /// Digitado o CPF, quando a pessoa está sem a carteirinha.
  CPF
}

/// Entrada no CLUBE (ou em qualquer espaço controlado do sindicato).
///
/// POR QUE NÃO É `Presenca`
/// `Presenca` significa "esteve NESTE EVENTO" em todo o sistema — alimenta
/// certificado, quórum de plenário e relatório por evento, e `eventoId` é
/// obrigatório lá. Acesso ao clube é outro fato: acontece todo dia, sem evento,
/// e o que importa é quem entrou, quando e se foi liberado. Enfiar os dois na
/// mesma tabela obrigaria toda consulta de evento a filtrar o que não é evento
/// — o tipo de "duas verdades numa coluna só" que este sistema já pagou caro.
///
/// REGISTRA TAMBÉM QUEM FOI BARRADO, de propósito. Saber que um desfiliado
/// tentou entrar ontem é mais útil que saber que dez filiados entraram: é o
/// registro da recusa que a portaria precisa mostrar quando alguém reclama.
model RegistroAcesso {
  id String @id @default(uuid())

  tipoPessoa    TipoPessoa @map("tipo_pessoa")
  filiadoId     String?    @map("filiado_id")
  dependenteId  String?    @map("dependente_id")
  colaboradorId String?    @map("colaborador_id")

  /// Nome como estava no momento da entrada — o cadastro muda, o registro não.
  nomeSnapshot String   @map("nome_snapshot")
  registradoEm DateTime @default(now()) @map("registrado_em")

  origem        OrigemAcesso
  /// O que foi digitado quando a origem não é QR (matrícula ou CPF). Guardado
  /// para a portaria conseguir explicar uma recusa de alguém que não foi achado.
  identificador String?

  liberado Boolean
  /// Por que liberou ou negou, em texto — é o que a portaria mostra na tela.
  motivo   String

  /// Quem operou a portaria. Nulo em terminal de autoatendimento.
  registradoPor String? @map("registrado_por")
  ip            String?
  userAgent     String? @map("user_agent")

  filiado     Filiado?     @relation(fields: [filiadoId], references: [id], onDelete: SetNull)
  dependente  Dependente?  @relation(fields: [dependenteId], references: [id], onDelete: SetNull)
  colaborador Colaborador? @relation(fields: [colaboradorId], references: [id], onDelete: SetNull)

  @@index([registradoEm])
  @@index([filiadoId])
  @@map("registros_acesso")
}

enum OrigemPresenca {
  /// Leitura do QR Code na portaria (fluxo que já existia).
  QR_PRESENCIAL
  /// Autoatendimento do filiado na sala virtual, por CPF.
  AUTOATENDIMENTO_VIRTUAL
  /// Lançada à mão por alguém da equipe.
  MANUAL
}

// ============================================================================
// CARTEIRINHA DIGITAL
// ============================================================================

model Carteirinha {
  id        String            @id @default(uuid())
  filiadoId String            @unique @map("filiado_id")
  numero    String            @unique // número da carteirinha
  emitidaEm DateTime          @default(now()) @map("emitida_em")
  validaAte DateTime?         @map("valida_ate")
  status    StatusCarteirinha @default(ATIVA)
  pdfKey    String?           @map("pdf_key") // PDF gerado no storage
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  filiado Filiado @relation(fields: [filiadoId], references: [id], onDelete: Cascade)

  @@map("carteirinhas")
}

// ============================================================================
// DOCUMENTOS (termos, contratos, anexos)
// ============================================================================

model Documento {
  id            String        @id @default(uuid())
  tipo          TipoDocumento
  titulo        String
  storageKey    String        @map("storage_key")
  mimeType      String?       @map("mime_type")
  tamanhoBytes  Int?          @map("tamanho_bytes")
  assinado      Boolean       @default(false)
  assinaturaKey String?       @map("assinatura_key") // imagem da assinatura
  // Vínculo polimórfico (apenas um preenchido). `funcionario_id`/`prestador_id`
  // saíram na unificação — os documentos daquelas fichas foram remanejados para
  // o colaborador de mesmo CPF, que antes os via partidos em duas telas.
  filiadoId     String?       @map("filiado_id")
  colaboradorId String?       @map("colaborador_id")
  createdAt     DateTime      @default(now()) @map("created_at")

  filiado         Filiado?         @relation(fields: [filiadoId], references: [id], onDelete: Cascade)
  colaborador     Colaborador?     @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  /// Anexos que reaproveitaram este documento do cadastro (mesma storage_key).
  anexosDerivados AnexoDocumento[]

  @@index([filiadoId])
  @@index([colaboradorId])
  @@index([tipo])
  @@map("documentos")
}

// ============================================================================
// RECADASTRAMENTO (com histórico de alterações)
// ============================================================================

model Recadastramento {
  id              String                @id @default(uuid())
  filiadoId       String                @map("filiado_id")
  status          StatusRecadastramento @default(PENDENTE)
  // Snapshot dos dados antes e depois (JSON) para histórico/auditoria
  dadosAnteriores Json?                 @map("dados_anteriores")
  dadosNovos      Json                  @map("dados_novos")
  observacao      String?
  revisorId       String?               @map("revisor_id")
  revisadoEm      DateTime?             @map("revisado_em")
  createdAt       DateTime              @default(now()) @map("created_at")

  filiado Filiado @relation(fields: [filiadoId], references: [id], onDelete: Cascade)
  revisor User?   @relation("RecadastramentoRevisor", fields: [revisorId], references: [id], onDelete: SetNull)

  @@index([filiadoId])
  @@index([status])
  @@map("recadastramentos")
}

// ============================================================================
// AUDITORIA / LOGS
// ============================================================================

model Auditoria {
  id         String        @id @default(uuid())
  userId     String?       @map("user_id")
  acao       AcaoAuditoria
  entidade   String? // ex: "Filiado", "Evento"
  entidadeId String?       @map("entidade_id")
  descricao  String?
  ip         String?
  userAgent  String?       @map("user_agent")
  metadata   Json?
  createdAt  DateTime      @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([acao])
  @@index([createdAt])
  @@map("auditorias")
}

// ============================================================================
// IMPORTAÇÃO DE FILIADOS (migração do sistema legado)
// ============================================================================

model Importacao {
  id                  String              @id @default(uuid())
  nomeArquivo         String              @map("nome_arquivo")
  tamanhoBytes        Int                 @map("tamanho_bytes")
  status              StatusImportacao    @default(VALIDANDO)
  estrategia          EstrategiaDuplicado @default(IGNORAR)
  estrategiaMatricula EstrategiaMatricula @default(REGENERAR) @map("estrategia_matricula")
  permitirCpfInvalido Boolean             @default(false) @map("permitir_cpf_invalido")

  /// Qual planilha é esta. Default = LEGADO_CSV para que TODA importação já
  /// gravada continue significando exatamente o que significava.
  perfil PerfilImportacao @default(LEGADO_CSV)

  /// SHA-256 do arquivo enviado — é o que reconhece "esta planilha já foi
  /// importada" mesmo que alguém a renomeie.
  ///
  /// Nulo nas importações antigas (não havia hash quando foram feitas). Por
  /// isso o índice é comum e a checagem é da aplicação: um índice único aqui
  /// trataria todos os nulos históricos como... nada, mas travaria a migration
  /// se duas cargas do mesmo arquivo já existissem.
  hashArquivo String? @map("hash_arquivo")

  // Contadores
  total               Int                 @default(0)
  validos             Int                 @default(0)
  comErro             Int                 @default(0)
  duplicados          Int                 @default(0) // CPF já existe no sistema
  processados         Int                 @default(0)
  importados          Int                 @default(0)
  atualizados         Int                 @default(0)
  ignorados           Int                 @default(0)
  dispensados         Int                 @default(0) // matrícula colidiu e a pessoa foi dispensada

  /// Linhas que exigem decisão humana. Enquanto houver conflito PENDENTE a
  /// confirmação recusa — ver `FolhaPrefeituraService.confirmar`.
  conflitos       Int @default(0)
  /// Vínculos criados/atualizados. Contados à parte de `importados`, que conta
  /// PESSOAS: uma folha pode não criar ninguém e ainda assim corrigir 300
  /// lotações — e um relatório que só mostrasse pessoas diria "nada mudou".
  vinculosCriados    Int @default(0) @map("vinculos_criados")
  vinculosAtualizados Int @default(0) @map("vinculos_atualizados")
  // Mapeamento detectado (coluna do CSV -> campo do sistema)
  mapeamento          Json?
  // Execução
  iniciadoEm          DateTime?           @map("iniciado_em")
  finalizadoEm        DateTime?           @map("finalizado_em")
  duracaoMs           Int?                @map("duracao_ms")
  erroMensagem        String?             @map("erro_mensagem")
  userId              String?             @map("user_id")
  createdAt           DateTime            @default(now()) @map("created_at")

  linhas ImportacaoLinha[]

  @@index([status])
  @@index([createdAt])
  /// Consulta de reenvio: "já existe importação com este hash?".
  @@index([hashArquivo])
  @@map("importacoes")
}

model ImportacaoLinha {
  id                 String   @id @default(uuid())
  importacaoId       String   @map("importacao_id")
  linha              Int // número da linha no CSV (começando em 1)
  // Dados normalizados, prontos para criação
  dados              Json
  // Denormalizado para busca/prévia
  nome               String?
  cpf                String?
  matricula          String?
  telefone           String?
  empresa            String?
  situacao           String?
  // Denormalizado da folha da Prefeitura (o `empresa` acima recebe o Órgão)
  lotacao            String?
  cargo              String?
  quadro             String?
  // Validação
  valido             Boolean  @default(true)
  duplicadoNoSistema Boolean  @default(false) @map("duplicado_no_sistema")
  erros              Json? // string[] de mensagens bloqueantes
  avisos             Json? // string[] de mensagens informativas
  codigos            String[] @default([]) // códigos de problema (CPF_INVALIDO, etc.)

  /// O VEREDITO DA PRÉVIA. Nulo no perfil legado, que classifica por
  /// `valido`/`duplicadoNoSistema` e continua funcionando como antes.
  classificacao ClassificacaoLinha?
  /// Por que ficou em conflito — só preenchido quando `classificacao = CONFLITO`.
  motivoConflito MotivoConflito? @map("motivo_conflito")
  /// Cadastro que a prévia apontou como candidato. NÃO é decisão: é a pessoa
  /// que o operador vai olhar para dizer se é a mesma ou não.
  candidatoId    String?         @map("candidato_id")
  /// Resposta do operador. PENDENTE bloqueia a confirmação — é o que garante
  /// que ninguém importe conflito sem olhar.
  decisao        DecisaoConflito @default(PENDENTE)
  decididoPor    String?         @map("decidido_por")
  decididoEm     DateTime?       @map("decidido_em")

  /// DIFERENÇAS QUE ESTA LINHA PRODUZIU — `{campo: {de, para}}`.
  ///
  /// É o coração da auditoria: sem ele, "atualizados: 312" é um número que
  /// ninguém consegue conferir nem desfazer. Gravado na aplicação (prévia) e
  /// reconfirmado na execução.
  alteracoes Json?

  // Resultado da importação
  resultado          String? // IMPORTADO | ATUALIZADO | IGNORADO | ERRO
  filiadoId          String?  @map("filiado_id")
  /// Vínculo criado ou atualizado por esta linha.
  vinculoId          String?  @map("vinculo_id")
  createdAt          DateTime @default(now()) @map("created_at")

  importacao Importacao @relation(fields: [importacaoId], references: [id], onDelete: Cascade)

  @@index([importacaoId])
  @@index([importacaoId, valido])
  @@index([cpf])
  /// Filtros da tela de revisão: "mostre só os conflitos", "só os novos".
  @@index([importacaoId, classificacao])
  @@map("importacao_linhas")
}

// ============================================================================
// COLÔNIA DE FÉRIAS — Reservas
// Inventário fixo de 6 quartos; temporadas com 5 lotes de 48h.
// Dados pessoais tratados conforme a LGPD (Lei nº 13.709/2018): consentimento
// registrado (aceite + data + IP + versão do termo) e suporte a anonimização.
// ============================================================================

enum StatusTemporada {
  ATIVA // pública / aceita reservas
  INATIVA // oculta do público
}

enum ClimatizacaoQuarto {
  AR_CONDICIONADO
  VENTILADOR
}

enum ModoReservaQuarto {
  RESERVA_DIRETA // quartos 1-5: reserva direta pelo associado
  SORTEIO_OU_MANUAL // quarto 6: só por sorteio ou alocação manual da diretoria
}

enum FormacaoColonia {
  ENFERMEIRO
  TECNICO
  AUXILIAR
}

enum OrigemReserva {
  RESERVA_DIRETA
  SORTEIO
  ALOCACAO_MANUAL
}

enum StatusReserva {
  CONFIRMADA
  CANCELADA_ADMIN // soft-delete pela diretoria: devolve a vaga (lote+quarto) ao público
}

enum StatusSorteioInscricao {
  INSCRITO // na fila
  SORTEADO // ganhou o quarto 6
  NAO_SORTEADO // fila encerrada sem ser sorteado
  CANCELADO
}

/// Campanha/Temporada da colônia (ex.: "Colônia de Julho 2026").
/// O `slug` é o identificador da URL pública; `status` controla o acesso.
model ColoniaTemporada {
  id          String          @id @default(uuid())
  nome        String
  slug        String          @unique // URL pública da campanha (ex.: "julho-2026")
  ano         Int
  status      StatusTemporada @default(INATIVA)
  descricao   String?
  dataSorteio DateTime?       @map("data_sorteio") // data/hora do sorteio público (ex.: terça 19:30)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  lotes             ColoniaLote[]
  reservas          ColoniaReserva[]
  inscricoesSorteio ColoniaSorteioInscricao[]

  @@index([status])
  @@map("colonia_temporadas")
}

/// Lote = período de 48h dentro de uma temporada (5 por temporada).
model ColoniaLote {
  id          String   @id @default(uuid())
  temporadaId String   @map("temporada_id")
  numero      Int // 1..5
  dataInicio  DateTime @map("data_inicio")
  dataFim     DateTime @map("data_fim")
  createdAt   DateTime @default(now()) @map("created_at")

  temporada         ColoniaTemporada          @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  reservas          ColoniaReserva[]
  inscricoesSorteio ColoniaSorteioInscricao[]
  quartos           ColoniaQuarto[]

  @@unique([temporadaId, numero])
  @@index([temporadaId])
  @@map("colonia_lotes")
}

/// Inventário fixo de 6 quartos POR LOTE.
/// 1-3: Ar-condicionado / reserva direta · 4-5: Ventilador / reserva direta ·
/// 6: Ventilador / exclusivo sorteio ou alocação manual.
model ColoniaQuarto {
  id           String             @id @default(uuid())
  loteId       String             @map("lote_id")
  numero       Int // 1..6
  climatizacao ClimatizacaoQuarto
  modoReserva  ModoReservaQuarto  @map("modo_reserva")
  ativo        Boolean            @default(true)
  createdAt    DateTime           @default(now()) @map("created_at")

  lote     ColoniaLote      @relation(fields: [loteId], references: [id], onDelete: Cascade)
  reservas ColoniaReserva[]

  @@unique([loteId, numero])
  @@index([loteId])
  @@map("colonia_quartos")
}

/// Reserva (ou vaga de sorteio) de um quarto em um lote de uma temporada.
/// Guarda os dados de checkout enriquecidos + o consentimento LGPD.
model ColoniaReserva {
  id          String @id @default(uuid())
  temporadaId String @map("temporada_id")
  loteId      String @map("lote_id")
  quartoId    String @map("quarto_id")

  origem         OrigemReserva @default(RESERVA_DIRETA)
  status         StatusReserva @default(CONFIRMADA)
  // Flags administrativas
  alocacaoManual Boolean       @default(false) @map("alocacao_manual_diretoria") // alocado manualmente pela diretoria

  // ---- Dados de checkout (enriquecimento) ----
  nomeCompleto   String          @map("nome_completo")
  cpf            String // único por temporada entre reservas CONFIRMADAS (índice parcial na migração)
  dataNascimento DateTime?       @map("data_nascimento")
  telefone       String
  coren          String?
  email          String?
  formacao       FormacaoColonia
  localTrabalho1 String          @map("local_trabalho_1") // obrigatório
  localTrabalho2 String?         @map("local_trabalho_2") // opcional
  cidade         String
  estado         String

  // ---- LGPD: consentimento e termo de No-Show ----
  aceiteTermoNoShow Boolean   @default(false) @map("aceite_termo_no_show")
  termoVersao       String?   @map("termo_versao")
  consentimentoLgpd Boolean   @default(false) @map("consentimento_lgpd")
  consentimentoEm   DateTime? @map("consentimento_em")
  ipConsentimento   String?   @map("ip_consentimento")
  anonimizadaEm     DateTime? @map("anonimizada_em") // dados pessoais anonimizados após retenção

  // ---- Cancelamento (soft-delete) ----
  canceladaEm        DateTime? @map("cancelada_em")
  canceladaPor       String?   @map("cancelada_por") // usuário admin
  motivoCancelamento String?   @map("motivo_cancelamento")

  criadaPor String? @map("criada_por")

  // Sincronização com o cadastro de Filiado (uma vez por registro).
  filiadoSincronizadoEm DateTime? @map("filiado_sincronizado_em")
  filiadoSincronizacao  Json?     @map("filiado_sincronizacao") // snapshot [{campo,label,de,para}]
  filiadoSincronizadoId String?   @map("filiado_sincronizado_id") // filiado atualizado (para consulta)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  temporada ColoniaTemporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  lote      ColoniaLote      @relation(fields: [loteId], references: [id], onDelete: Cascade)
  quarto    ColoniaQuarto    @relation(fields: [quartoId], references: [id])

  @@index([temporadaId])
  @@index([loteId])
  @@index([quartoId])
  @@index([status])
  @@index([temporadaId, cpf])
  @@map("colonia_reservas")
}

/// Fila de sorteio do quarto 6 de um lote. Guarda os mesmos dados de checkout
/// para virar reserva ao ser sorteado. CPF único (ativo) por temporada.
model ColoniaSorteioInscricao {
  id              String                 @id @default(uuid())
  temporadaId     String                 @map("temporada_id")
  loteId          String                 @map("lote_id")
  status          StatusSorteioInscricao @default(INSCRITO)
  // Posição na FILA DE SUPLENTES definida no sorteio (1 = primeiro a ser
  // promovido caso a reserva do contemplado seja cancelada). Nulo p/ INSCRITO.
  posicaoSuplente Int?                   @map("posicao_suplente")

  // ---- Dados de checkout (enriquecimento) ----
  nomeCompleto   String          @map("nome_completo")
  cpf            String
  dataNascimento DateTime?       @map("data_nascimento")
  telefone       String
  coren          String?
  email          String?
  formacao       FormacaoColonia
  localTrabalho1 String          @map("local_trabalho_1")
  localTrabalho2 String?         @map("local_trabalho_2")
  cidade         String
  estado         String

  // ---- LGPD / Marco Civil ----
  aceiteTermoNoShow Boolean   @default(false) @map("aceite_termo_no_show")
  consentimentoLgpd Boolean   @default(false) @map("consentimento_lgpd")
  consentimentoEm   DateTime? @map("consentimento_em")
  ipInscricao       String?   @map("ip_inscricao")

  reservaId String? @map("reserva_id") // preenchido quando vira reserva (sorteado)

  // Sincronização com o cadastro de Filiado (uma vez por registro).
  filiadoSincronizadoEm DateTime? @map("filiado_sincronizado_em")
  filiadoSincronizacao  Json?     @map("filiado_sincronizacao") // snapshot [{campo,label,de,para}]
  filiadoSincronizadoId String?   @map("filiado_sincronizado_id") // filiado atualizado (para consulta)

  createdAt DateTime @default(now()) @map("created_at")

  temporada ColoniaTemporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)
  lote      ColoniaLote      @relation(fields: [loteId], references: [id], onDelete: Cascade)

  @@index([temporadaId])
  @@index([loteId])
  @@index([status])
  @@index([temporadaId, cpf])
  @@map("colonia_sorteio_inscricoes")
}

// ============================================================================
// COLABORADORES + CADASTROS BASE (parâmetros)
// Tabelas de domínio específicas (integridade referencial) — sem tabela genérica.
// ============================================================================

enum TipoVinculo {
  CLT
  PJ
  ESTAGIO
  TERCEIRIZADO
}

enum StatusColaborador {
  ATIVO
  INATIVO
  AFASTADO
  FERIAS
  DESLIGADO
}

/// Departamento de um Colaborador.
///
/// Lista de apoio do módulo de Colaboradores — é o único que a usa. Vivia num
/// "Cadastros Base" próprio, com menu e permissão só para isto; foi absorvida
/// por Colaboradores, no mesmo padrão dos tipos de evento da Agenda.
///
/// `ativo` em vez de exclusão: a FK em Colaborador é OBRIGATÓRIA, então apagar
/// um departamento em uso é impossível e mantê-lo na lista para sempre é ruim.
/// Ocultar aposenta o registro sem quebrar o histórico de quem já o usa.
model Departamento {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  colaboradores Colaborador[]

  @@map("departamentos")
}

/// Cargo de um Colaborador. Mesma história de [Departamento].
model Cargo {
  id        String   @id @default(uuid())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  colaboradores Colaborador[]

  @@map("cargos")
}

/// Empresa (pessoa jurídica).
///
/// Nasceu como empregadora de colaboradores PJ/terceirizados e agora é também
/// a entidade do MÓDULO PATRONAL: as conveniadas acessam o portal com as
/// credenciais abaixo. Uma empresa só de vínculo simplesmente não tem senha.
model Empresa {
  id           String  @id @default(uuid())
  /// Somente dígitos (14), sem máscara — formatar é responsabilidade da tela.
  cnpj         String  @unique
  razaoSocial  String  @map("razao_social")
  /// Muitas empresas não têm nome fantasia; a BrasilAPI devolve vazio nesses casos.
  nomeFantasia String? @map("nome_fantasia")

  // Endereço — opcional porque a BrasilAPI pode estar fora do ar e o cadastro
  // precisa poder ser concluído à mão.
  cep        String?
  logradouro String?
  bairro     String?
  cidade     String?
  uf         String?

  /// bcrypt do acesso ao portal patronal. NULO enquanto a empresa não foi
  /// habilitada. NUNCA sai da API — os serviços selecionam campo a campo.
  senhaHash      String?  @map("senha_hash")
  /// A senha provisória definida pela secretaria ainda precisa ser trocada.
  primeiroAcesso Boolean  @default(true) @map("primeiro_acesso")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  colaboradores Colaborador[]
  contribuicoes ContribuicaoPatronal[]

  @@index([razaoSocial])
  @@map("empresas")
}

/// Pessoa da equipe do sindicato — CLT, PJ, estagiário ou terceirizado.
///
/// É o cadastro ÚNICO. Substituiu de vez `Funcionario` e `Prestador` (pessoa
/// física), que conviviam com ele guardando a mesma gente: a unificação tinha
/// sido feita pela metade — o menu deixou de mostrar os antigos, mas os módulos
/// seguiam ativos e os registros divergiam em silêncio (editar aqui não tocava
/// lá, e o QR do check-in lia o registro que ninguém atualizava).
///
/// Por isso este modelo absorveu o que só existia no legado: `qrToken` (entrada
/// em evento), `fotoThumbKey` (miniatura que a portaria vê) e `matricula` (o
/// número do crachá). Prestador PJ virou Empresa, no módulo Patronal.
model Colaborador {
  id                 String            @id @default(uuid())
  /// Número do crachá (FUNC-000001). Opcional: só quem precisa de identificação
  /// física recebe — o cadastro não depende disso para existir.
  matricula          String?           @unique
  // Dados universais
  fotoUrl            String?           @map("foto_url") // resolvido a partir de fotoKey (upload)
  fotoKey            String?           @map("foto_key") // chave da foto enviada no storage
  /// Miniatura da foto — é o que a tela de check-in mostra ao ler o QR.
  fotoThumbKey       String?           @map("foto_thumb_key")
  /// Token do QR Code de entrada em eventos. Gerado no cadastro e nunca exposto:
  /// o que circula é o payload assinado (HMAC de id+tipo+token).
  qrToken            String            @unique @map("qr_token")
  nome               String
  cpf                String            @unique // LGPD: dado mínimo necessário; mascarado na exibição
  dataNascimento     DateTime?         @map("data_nascimento")
  telefone           String?
  email              String?
  dataAdmissao       DateTime?         @map("data_admissao")
  status             StatusColaborador @default(ATIVO)
  tipoVinculo        TipoVinculo       @map("tipo_vinculo")
  // Situação dinâmica (conforme o status)
  statusMotivo       String?           @map("status_motivo") // obrigatório em INATIVO/AFASTADO
  dataDesligamento   DateTime?         @map("data_desligamento") // obrigatório em DESLIGADO
  feriasInicio       DateTime?         @map("ferias_inicio") // início das férias
  feriasRetornoEm    DateTime?         @map("ferias_retorno_em") // fim/retorno automático a ATIVO (FERIAS)
  // Endereço
  cep                String?
  logradouro         String?
  numero             String?
  bairro             String?
  cidade             String?
  uf                 String?
  // Campos dinâmicos (condicionais ao vínculo)
  vencimentoContrato DateTime?         @map("vencimento_contrato")
  instituicaoEnsino  String?           @map("instituicao_ensino")
  // Relacionamentos
  cargoId            String            @map("cargo_id")
  departamentoId     String            @map("departamento_id")
  empresaId          String?           @map("empresa_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  cargo           Cargo                  @relation(fields: [cargoId], references: [id])
  departamento    Departamento           @relation(fields: [departamentoId], references: [id])
  empresa         Empresa?               @relation(fields: [empresaId], references: [id], onDelete: SetNull)
  historico       ColaboradorHistorico[]
  documentos      Documento[]
  presencas       Presenca[]
  registrosAcesso RegistroAcesso[]

  @@index([status])
  @@index([cargoId])
  @@index([departamentoId])
  @@index([empresaId])
  @@map("colaboradores")
}

enum TipoHistoricoColaborador {
  CADASTRO
  ALTERACAO
  MUDANCA_STATUS
  UPLOAD_FOTO
}

model ColaboradorHistorico {
  id            String                   @id @default(uuid())
  colaboradorId String                   @map("colaborador_id")
  tipo          TipoHistoricoColaborador
  descricao     String
  autor         String?
  metadata      Json?
  createdAt     DateTime                 @default(now()) @map("created_at")

  colaborador Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)

  @@index([colaboradorId])
  @@map("colaborador_historico")
}

// ===========================================================================
// COBRANÇAS E CARNÊS (gestão financeira dos filiados)
// ===========================================================================

enum TipoCobranca {
  MENSALIDADE
  ANUIDADE
  ACORDO
  TAXA
  CONTRIBUICAO
  OUTRO
}

enum StatusParcela {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

/// Configuração institucional para emissão de carnês/cobranças (registro único).
/// LGPD: guarda apenas dados institucionais do sindicato — nada de dados pessoais.
model ConfiguracaoSindicato {
  id                      String   @id @default(uuid())
  logoUrl                 String?  @map("logo_url")
  assinaturaPresidenteUrl String?  @map("assinatura_presidente_url")
  textoRodapeCarne        String?  @map("texto_rodape_carne")
  // PIX estático (recebedor)
  pixChave                String?  @map("pix_chave")
  pixNomeRecebedor        String?  @map("pix_nome_recebedor")
  pixCidade               String?  @map("pix_cidade")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("configuracao_sindicato")
}

/// Cobrança "pai" (contrato) vinculada a um filiado — agrupa as parcelas do carnê.
model Cobranca {
  id         String       @id @default(uuid())
  filiadoId  String       @map("filiado_id")
  tipo       TipoCobranca @default(MENSALIDADE)
  descricao  String?
  valorTotal Decimal      @map("valor_total") @db.Decimal(10, 2)
  criadaPor  String?      @map("criada_por") // usuário admin que gerou
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  filiado  Filiado           @relation(fields: [filiadoId], references: [id], onDelete: Cascade)
  parcelas ParcelaCobranca[]

  @@index([filiadoId])
  @@map("cobrancas")
}

/// Parcela de uma cobrança (linha do carnê).
model ParcelaCobranca {
  id              String        @id @default(uuid())
  cobrancaId      String        @map("cobranca_id")
  numero          Int // ordem no carnê (1..n)
  dataCompetencia DateTime      @map("data_competencia") @db.Date
  dataVencimento  DateTime      @map("data_vencimento") @db.Date
  valor           Decimal       @db.Decimal(10, 2)
  status          StatusParcela @default(PENDENTE)
  dataPagamento   DateTime?     @map("data_pagamento")
  valorPago       Decimal?      @map("valor_pago") @db.Decimal(10, 2) // valor efetivamente recebido (juros/desconto)
  // Rastreio financeiro: movimentação de ENTRADA gerada na baixa desta parcela.
  movimentacaoId  String?       @unique @map("movimentacao_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  cobranca     Cobranca      @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)
  movimentacao Movimentacao? @relation(fields: [movimentacaoId], references: [id], onDelete: SetNull)

  @@index([cobrancaId])
  @@index([status])
  @@map("parcelas_cobranca")
}

// ===========================================================================
// FINANCEIRO (contas bancárias e movimentações)
// ===========================================================================

enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

/// Conta bancária / caixa do sindicato para onde entram/saem valores.
model ContaBancaria {
  id          String   @id @default(uuid())
  nome        String // ex.: "Caixa do Sindicato", "Banco do Brasil CC"
  instituicao String? // banco/instituição
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  movimentacoes Movimentacao[]

  @@map("contas_bancarias")
}

/// Lançamento financeiro (entrada/saída) vinculado a uma conta bancária.
model Movimentacao {
  id              String           @id @default(uuid())
  contaBancariaId String           @map("conta_bancaria_id")
  tipo            TipoMovimentacao
  valor           Decimal          @db.Decimal(10, 2)
  descricao       String
  data            DateTime         @default(now())
  origem          String? // ex.: "COBRANCA"
  criadaPor       String?          @map("criada_por")
  createdAt       DateTime         @default(now()) @map("created_at")

  conta                ContaBancaria         @relation(fields: [contaBancariaId], references: [id], onDelete: Restrict)
  parcela              ParcelaCobranca? // preenchida quando a movimentação nasce da baixa de uma parcela
  contribuicaoPatronal ContribuicaoPatronal? // preenchida quando nasce da homologação patronal

  @@index([contaBancariaId])
  @@index([tipo])
  @@index([data])
  @@map("movimentacoes")
}

// ===========================================================================
// TRIAGEM E ATENDIMENTOS (funil de entrada das demandas dos filiados)
// ===========================================================================

enum CanalAtendimento {
  PRESENCIAL
  WHATSAPP
  TELEFONE
  EMAIL
  SITE
}

enum DesfechoAtendimento {
  RESOLVIDO_ATO // resolvido na hora — vira só histórico
  ENCAMINHADO // demanda passada ao Jurídico/outro setor
}

enum SetorAtendimento {
  JURIDICO
  FINANCEIRO
  SECRETARIA
  DIRETORIA
  COLONIA
  OUTRO
}

/// Natureza do encaminhamento jurídico de um atendimento.
enum TipoEncaminhamento {
  CONSULTA_NOVA // consulta jurídica de caso novo
  ANDAMENTO_PROCESSO // sobre um processo já cadastrado
}

/// Situação da demanda de triagem (independe do desfecho/resultado).
enum StatusAtendimento {
  PENDENTE // aberta — aguardando conclusão
  CONCLUIDO // demanda fechada
  CANCELADO // atendimento cancelado
}

/// Registro de atendimento/triagem — todo pedido do filiado começa aqui.
model Atendimento {
  id                 String               @id @default(uuid())
  numero             Int                  @unique @default(autoincrement()) // nº sequencial (#393)
  filiadoId          String               @map("filiado_id")
  atendentePorId     String               @map("atendente_por_id") // usuário logado que registrou
  canal              CanalAtendimento
  descricao          String // demanda (texto rico)
  // Situação da demanda (aberta até ser concluída/cancelada).
  status             StatusAtendimento    @default(PENDENTE)
  // Desfecho/resultado é registrado DEPOIS (null = ainda sem resultado).
  desfecho           DesfechoAtendimento?
  desfechoEm         DateTime?            @map("desfecho_em")
  desfechoObs        String?              @map("desfecho_obs") // resolução (RESOLVIDO_ATO) ou nota
  // Encaminhamento (desfecho = ENCAMINHADO — sempre ao Jurídico/advogado):
  tipoEncaminhamento TipoEncaminhamento?  @map("tipo_encaminhamento")
  processoId         String?              @map("processo_id") // quando ANDAMENTO_PROCESSO
  setor              SetorAtendimento?
  responsavel        String? // nome(s) do(s) advogado(s) — para exibição rápida
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  filiado      Filiado          @relation(fields: [filiadoId], references: [id], onDelete: Cascade)
  atendente    User             @relation(fields: [atendentePorId], references: [id])
  processo     Processo?        @relation(fields: [processoId], references: [id], onDelete: SetNull)
  compromissos Compromisso[]
  anexos       AnexoDocumento[]

  @@index([filiadoId])
  @@index([desfecho])
  @@index([status])
  @@index([canal])
  @@index([createdAt])
  @@map("atendimentos")
}

// ===========================================================================
// AGENDA E PRAZOS (compromissos dos advogados/colaboradores)
// ===========================================================================

enum StatusCompromisso {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

/// COMO a atividade terminou — obrigatório ao concluir.
///
/// Antes, "Concluído" era um clique só: o evento sumia do quadro sem dizer o que
/// aconteceu com a demanda do filiado. Estes valores existem para que a conclusão
/// registre o RESULTADO, e não apenas o fim.
enum DesfechoCompromisso {
  DUVIDA_ESCLARECIDA // consulta resolvida na hora — a orientação vai na observação
  REALIZADO // audiência/prazo/diligência cumprida conforme planejado
  VINCULADO_PROCESSO // a demanda pertence a um processo que já existe
  PROCESSO_CRIADO // virou processo novo, aberto como RASCUNHO para o advogado formalizar
  NAO_COMPARECEU // o filiado não compareceu
  OUTRO // qualquer outro fim — exige descrição
}

/// Tipo de evento da Agenda — CADASTRÁVEL. Os 8 tipos "sistema" são semeados na
/// migração inicial e não podem ser excluídos (só renomeados/recoloridos/ocultados);
/// tipos personalizados podem ser criados livremente. `slug` é o identificador
/// estável guardado em Compromisso.tipo; `cor` é uma chave de paleta (sky, red…).
/// (Nome "TipoCompromisso" para não colidir com o enum TipoEvento dos Eventos.)
model TipoCompromisso {
  id        String   @id @default(uuid())
  slug      String   @unique
  nome      String
  cor       String   @default("slate")
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  sistema   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tipos_evento")
}

/// Compromisso da agenda (audiência, prazo, reunião…). Rastreável ao filiado e
/// ao atendimento de origem. Data original travada quando remarcado (auditoria).
model Compromisso {
  id                  String            @id @default(uuid())
  titulo              String
  tipo                String // slug de TipoEvento (cadastrável)
  status              StatusCompromisso @default(PENDENTE)
  inicio              DateTime
  fim                 DateTime
  local               String? // ex.: "1ª Vara do Trabalho de Teresina"
  descricao           String?
  observacoesInternas String?           @map("observacoes_internas") // notas internas — não visíveis ao filiado
  urgente             Boolean           @default(false)
  iniciadoEm          DateTime?         @map("iniciado_em") // quando entrou EM_ANDAMENTO (timer/alertas)
  responsavelId       String            @map("responsavel_id")
  filiadoId           String?           @map("filiado_id")
  atendimentoId       String?           @map("atendimento_id")
  processoId          String?           @map("processo_id")
  // Trilha de auditoria: 1ª data agendada, gravada e TRAVADA na 1ª remarcação.
  dataOriginal        DateTime?         @map("data_original")
  /// Quantas vezes já foi remarcado — um evento remarcado 4x é um sinal de gestão,
  /// não um detalhe. Precomputado para a lista não ter de varrer a auditoria.
  remarcacoes         Int               @default(0)
  /// Motivo da ÚLTIMA remarcação (o histórico completo fica na Auditoria).
  remarcadoMotivo     String?           @map("remarcado_motivo")

  // ---- Conclusão: o que aconteceu com a demanda ----
  /// Slug do desfecho, definido pelo TIPO da atividade (ver desfechos.catalogo.ts).
  /// Texto e não enum: os desfechos variam por tipo e mudam com o uso — um enum
  /// exigiria migração a cada ajuste, como já aconteceu com `tipo`.
  desfecho     String?
  /// Comentário do desfecho (a orientação dada, o que foi decidido).
  desfechoObs  String?   @map("desfecho_obs")
  concluidoEm  DateTime? @map("concluido_em")
  concluidoPor String?   @map("concluido_por")

  // ---- Cancelamento: motivo é OBRIGATÓRIO (regra de negócio) ----
  /// Por que foi cancelado. Sem isto, "Cancelado" no quadro não explica nada a
  /// quem abre o evento semanas depois.
  /// Categoria do cancelamento (NAO_COMPARECEU, DESISTENCIA…). "Não compareceu"
  /// mora AQUI, e não no desfecho: quem não compareceu não realizou a atividade.
  canceladoCategoria String?   @map("cancelado_categoria")
  canceladoMotivo    String?   @map("cancelado_motivo")
  canceladoEm        DateTime? @map("cancelado_em")
  canceladoPor       String?   @map("cancelado_por")

  /// Quem registrou o evento. Virou FK (era só o id solto em texto) para a tela
  /// poder mostrar nome E FOTO de quem criou a demanda, sem consulta extra.
  criadoPor        String?  @map("criado_por")
  /// Gerado pelo robô de automação (a partir de uma movimentação do DataJud) —
  /// a interface marca esses eventos com o selo "Criado pelo Sistema".
  origemAutomatica Boolean  @default(false) @map("origem_automatica")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  responsavel         User                     @relation("CompromissoResponsavel", fields: [responsavelId], references: [id])
  criador             User?                    @relation("CompromissoCriador", fields: [criadoPor], references: [id], onDelete: SetNull)
  filiado             Filiado?                 @relation(fields: [filiadoId], references: [id], onDelete: SetNull)
  atendimento         Atendimento?             @relation(fields: [atendimentoId], references: [id], onDelete: SetNull)
  processo            Processo?                @relation(fields: [processoId], references: [id], onDelete: SetNull)
  /// Movimentações do DataJud que originaram este evento (radar de audiências).
  origemMovimentacoes MovimentacaoProcessual[]
  /// Publicações do DJEN que criaram ou enriqueceram esta atividade.
  origemComunicacoes  ComunicacaoDjen[]
  historico           CompromissoHistorico[]
  /// Documentos da própria atividade (enviados ou puxados do acervo do filiado).
  /// Os anexos da triagem/processo de origem continuam visíveis por herança —
  /// não são copiados para cá.
  anexos              AnexoDocumento[]

  /// Processo (rascunho) gerado a partir do desfecho desta atividade.
  processoGerado Processo? @relation("ProcessoOrigemCompromisso")

  @@index([status])
  @@index([tipo])
  @@index([inicio])
  @@index([responsavelId])
  @@index([filiadoId])
  @@index([processoId])
  @@index([criadoPor])
  @@map("compromissos")
}

/// Escala de plantão/expediente de um advogado (colaborador) numa data.
model EscalaAdvogado {
  id         String   @id @default(uuid())
  advogadoId String   @map("advogado_id")
  data       DateTime @db.Date
  horaInicio String   @map("hora_inicio") // "HH:MM"
  horaFim    String   @map("hora_fim") // "HH:MM"
  observacao String?
  criadoPor  String?  @map("criado_por")
  createdAt  DateTime @default(now()) @map("created_at")

  advogado User @relation(fields: [advogadoId], references: [id], onDelete: Cascade)

  @@index([advogadoId])
  @@index([data])
  @@map("escalas_advogados")
}

// ===========================================================================
// PROCESSOS (cache local dos metadados públicos do DATAJUD/CNJ)
// LGPD (Lei 13.709/2018): a API Pública do DATAJUD expõe apenas METADADOS
// processuais públicos — não traz dados pessoais das partes. Ainda assim,
// tratamos o vínculo interno (filiado/advogado) como dado sob acesso restrito.
// ===========================================================================

enum StatusProcesso {
  /// RASCUNHO: aberto a partir de uma consulta/atendimento, AINDA SEM NPU. O
  /// advogado formaliza depois — informando o número e puxando do DataJud, ou
  /// preenchendo à mão. É o único status em que `numeroCNJ` pode ser nulo, e
  /// rascunhos NUNCA entram na varredura noturna do CNJ (não há o que consultar).
  RASCUNHO
  ATIVO
  ARQUIVADO
  SUSPENSO
  PENDENTE // distribuído, aguardando movimentação
  ENCERRADO // baixado/transitado em julgado
  GANHO_EXECUCAO // procedente, em fase de execução/cumprimento
  IMPROCEDENTE // julgado improcedente
}

/// Polo em que a parte figura no processo.
enum PoloProcesso {
  ATIVO // quem PROPÔS a ação (autor / reclamante / exequente / impetrante)
  PASSIVO // contra quem a ação foi proposta (réu / reclamada / executada)
  TERCEIRO // assistente, litisconsorte facultativo, MP, perito, terceiro interessado
}

/// Natureza da parte externa (define quais campos a tela pede).
enum TipoParteExterna {
  FISICA // pessoa física (CPF)
  JURIDICA // empresa (CNPJ) — ex.: PRONTOCARE
  ORGAO_PUBLICO // município, estado, autarquia, fundação (CNPJ)
}

/// Natureza da atuação do sindicato no processo.
///
/// INSTITUCIONAL é a ação coletiva em que o SENATEPI figura no polo ativo em
/// nome da categoria — não há um filiado "dono" do processo, e cobrar um
/// vínculo de filiado ali seria forçar um dado que não existe.
enum TipoAcaoProcesso {
  INDIVIDUAL
  INSTITUCIONAL
}

/// Processo judicial espelhado do DATAJUD (cache) + vínculos internos.
model Processo {
  id String @id @default(uuid())

  /// NPU (20 dígitos). NULO apenas em RASCUNHO — processo aberto a partir de uma
  /// consulta e ainda não distribuído/formalizado. Continua ÚNICO quando
  /// preenchido: no Postgres um índice único aceita vários NULLs, então dois
  /// rascunhos coexistem sem colidir.
  numeroCNJ String? @unique @map("numero_cnj")

  /// Rótulo do processo enquanto ele não tem NPU nem classe do CNJ — sem isto o
  /// rascunho apareceria como uma linha em branco na lista. Assim que o processo
  /// é formalizado, a classe do DataJud assume o lugar na exibição.
  titulo String?

  /// De onde veio o rascunho: a atividade da agenda que o originou. Guarda a
  /// rastreabilidade "esta consulta virou este processo".
  origemCompromissoId String? @unique @map("origem_compromisso_id")

  /// FILIADO PRINCIPAL e ADVOGADO RESPONSÁVEL.
  ///
  /// Desde a multivinculação (N:N em `partes_processo` e `processos_advogados`),
  /// estas duas colunas são um ATALHO DENORMALIZADO: apontam para a linha marcada
  /// como `principal` nas tabelas de vínculo. Existem por dois motivos concretos:
  /// (1) telas e filtros de alto volume (lista, dashboard, "meus processos",
  /// radar de audiências) fazem um WHERE indexado direto, sem join; (2) mantêm
  /// compatível tudo que já lia `filiadoId`/`advogadoId`.
  ///
  /// REGRA: quem escreve nelas é APENAS o `PartesService.sincronizarAtalhos()`,
  /// sempre na mesma transação da escrita na tabela N:N. Nunca atualize por fora —
  /// o atalho sairia de sincronia com a fonte de verdade.
  filiadoId  String? @map("filiado_id")
  advogadoId String? @map("advogado_id")

  // ---- Metadados públicos do DATAJUD ----
  classeProcessual    String?   @map("classe_processual")
  classeCodigo        Int?      @map("classe_codigo") // código TPU da classe
  assuntoPrincipal    String?   @map("assunto_principal")
  /// Todos os assuntos [{codigo, nome, principal}] — o principal também fica acima.
  assuntos            Json?
  orgaoJulgador       String?   @map("orgao_julgador")
  orgaoJulgadorCodigo String?   @map("orgao_julgador_codigo")
  municipioIBGE       Int?      @map("municipio_ibge")
  tribunal            String? // sigla: TJPI, TRT22, TRF1…
  dataDistribuicao    DateTime? @map("data_distribuicao")
  valorCausa          Decimal?  @map("valor_causa") @db.Decimal(14, 2)
  grau                String?
  /// "Eletrônico" / "Físico" (formato.nome).
  formato             String?
  /// Sistema de origem no tribunal (ex.: PJe, eproc, Projudi).
  sistema             String?
  /// nivelSigilo do CNJ (0 = público). > 0 ⇒ segredo de justiça.
  nivelSigilo         Int?      @map("nivel_sigilo")
  segredoJustica      Boolean   @default(false) @map("segredo_justica")
  /// Tags de prioridade legal (ex.: "Idoso", "Réu preso") quando o tribunal envia.
  prioridades         Json?
  /// Carimbo de última atualização informado pelo próprio CNJ.
  atualizadoNoCnjEm   DateTime? @map("atualizado_no_cnj_em")
  /// PARTES BRUTAS do processo (nome/documento/polo/advogados) exatamente como
  /// vieram do tribunal. Regra de negócio: quando o CPF não casa com nenhum
  /// Filiado, NÃO criamos rascunho na tabela de filiados — o dado fica aqui, e a
  /// tela oferece "Vincular a filiado existente" ou "Criar novo filiado".
  partesBrutas        Json?     @map("partes_brutas")

  // ---- Dados internos do sindicato ----
  /// INSTITUCIONAL = ação coletiva movida pelo SENATEPI em nome da categoria.
  /// Escolhido na importação e usado para exibir a badge "Ação Institucional" e
  /// para NÃO cobrar filiado vinculado — num processo coletivo não há um dono.
  tipoAcao            TipoAcaoProcesso @default(INDIVIDUAL) @map("tipo_acao")
  /// Etiquetas livres da equipe (Urgente, Fase de Execução, Coletiva…).
  /// Texto puro de propósito: são rótulos operacionais que mudam com o tempo e
  /// não valem uma tabela + join só para isso.
  etiquetas           String[]         @default([])
  statusInterno       StatusProcesso   @default(ATIVO) @map("status_interno")
  ultimaSincronizacao DateTime?        @map("ultima_sincronizacao")
  /// Última vez que ESTE processo foi consultado no DJEN, um a um.
  ///
  /// Existe para dar rodízio à varredura complementar. A consulta por OAB cobre
  /// o caso comum; a consulta processo a processo cobre a exceção (processo em
  /// que a OAB do sindicato não consta do polo) e custa uma requisição por
  /// processo — contra uma cota de 20 por minuto no CNJ. Sem este carimbo, o
  /// robô não teria como saber quem já foi visto e varreria sempre a mesma
  /// fatia, deixando o resto no escuro para sempre.
  ultimaConsultaDjen  DateTime?        @map("ultima_consulta_djen")
  /// Quando o parser MULTI-INSTÂNCIA leu este processo pela última vez.
  /// Nulo = o processo é anterior ao parser (ou só passou pelo backfill), e a
  /// tela pede a reavaliação ao ser aberta. Ver `reavaliarInstancias`.
  instanciasLidasEm   DateTime?        @map("instancias_lidas_em")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  filiado               Filiado?                  @relation(fields: [filiadoId], references: [id], onDelete: SetNull)
  advogado              User?                     @relation("ProcessoAdvogado", fields: [advogadoId], references: [id], onDelete: SetNull)
  /// Graus/instâncias do MESMO número de processo (ver ProcessoInstancia).
  instancias            ProcessoInstancia[]
  /// Publicações do DJEN casadas com este processo.
  comunicacoes          ComunicacaoDjen[]
  movimentacoes         MovimentacaoProcessual[]
  movimentacoesInternas MovimentacaoInterna[]
  anexos                AnexoDocumento[]
  compromissos          Compromisso[]
  atendimentos          Atendimento[]
  logsSincronizacao     LogSincronizacaoDatajud[]
  /// Partes do processo (polo ativo/passivo/terceiros) — fonte de verdade do
  /// "quem processou quem" e também dos FILIADOS vinculados (N:N).
  partes                ParteProcesso[]
  /// Advogados da casa que atuam no processo (N:N). O `principal` é o responsável.
  advogados             ProcessoAdvogado[]
  /// Atividade da agenda que originou este processo (quando veio de um desfecho).
  origemCompromisso     Compromisso?              @relation("ProcessoOrigemCompromisso", fields: [origemCompromissoId], references: [id], onDelete: SetNull)

  @@index([filiadoId])
  @@index([advogadoId])
  @@index([statusInterno])
  @@index([tribunal])
  @@map("processos")
}

/// UMA INSTÂNCIA (grau) do mesmo número de processo.
///
/// POR QUE ESTA TABELA EXISTE
/// O DataJud devolve UM DOCUMENTO POR GRAU, todos no mesmo índice do tribunal,
/// distinguidos pelo `_id` (`TJPI_G1_<npu>`, `TJPI_G2_<npu>`). Cada documento
/// carrega o PRÓPRIO array de movimentos. Verificado no NPU
/// 0831236-24.2023.8.18.0140: o G2 traz 16 movimentos e o G1 traz 42.
///
/// Até aqui o sistema lia `hits[0]` e descartava o resto — qual dos dois
/// sobrevivia dependia da ordenação por relevância do Elasticsearch, e as
/// movimentações do outro simplesmente nunca existiam no banco. Guardar os dois
/// como linhas de `processos` era impossível: `numero_cnj` é ÚNICO, e é assim
/// que deve continuar (é o mesmo processo, com a mesma parte e o mesmo advogado
/// responsável — o que muda é o grau).
///
/// CICLO DE VIDA PRÓPRIO: o 2º grau pode estar baixado enquanto o 1º volta a
/// correr em cumprimento de sentença. É por isso que `baixada` e
/// `ultimo_movimento_em` moram aqui, e não em `processos`.
model ProcessoInstancia {
  id         String @id @default(uuid())
  processoId String @map("processo_id")

  /// `_id` do documento no DataJud (ex.: "TJPI_G1_08312362420238180140").
  /// Chave natural e estável entre sincronizações — melhor que (grau, tribunal)
  /// porque é exatamente o que o CNJ usa para identificar o documento.
  docId    String @map("doc_id")
  /// G1 (1º grau), G2 (2º grau), JE (juizado especial), TR (turma recursal).
  /// Texto: cada tribunal usa um subconjunto e novos valores aparecem sem aviso.
  grau     String
  tribunal String

  classeProcessual    String?   @map("classe_processual")
  classeCodigo        Int?      @map("classe_codigo")
  orgaoJulgador       String?   @map("orgao_julgador")
  orgaoJulgadorCodigo String?   @map("orgao_julgador_codigo")
  dataDistribuicao    DateTime? @map("data_distribuicao")
  nivelSigilo         Int?      @map("nivel_sigilo")
  /// Assuntos DESTA instância. Guardados por instância porque MUDAM entre os
  /// graus — conferido nos 5 processos da produção em 07/08/2026: no
  /// 0001000-26.2022.5.22.0002 o 1º grau trata de "Adicional de Insalubridade"
  /// e o 2º de "Multa de 40% do FGTS". Gravar só os de uma instância (a
  /// primeira que o Elasticsearch devolvesse) perdia os demais — e com eles a
  /// etiqueta de perícia, que depende justamente do assunto.
  assuntos            Json?
  assuntoPrincipal    String?   @map("assunto_principal")
  formato             String?
  sistema             String?
  /// Carimbo de última atualização informado pelo CNJ.
  atualizadoNoCnjEm   DateTime? @map("atualizado_no_cnj_em")

  /// Data do movimento MAIS RECENTE desta instância.
  ///
  /// É por ela que se decide qual instância está viva — e NÃO por
  /// `atualizadoNoCnjEm`, que é o carimbo de INGESTÃO do CNJ e vem praticamente
  /// igual nos dois graus (verificado: mesmo NPU, ambos 2026-08-03, enquanto os
  /// movimentos reais eram de 2026-05 no G2 e 2025-11 no G1). Usar o carimbo do
  /// CNJ para isso escolheria a instância errada.
  ultimoMovimentoEm DateTime? @map("ultimo_movimento_em")

  /// Recebeu Baixa Definitiva (TPU 22) ou Trânsito em julgado (848) sem
  /// Desarquivamento (893) posterior. Instância baixada sai do rodízio de
  /// "instância principal", mas continua no banco: o histórico dela é o que
  /// explica de onde veio o processo.
  baixada Boolean @default(false)

  /// Instância que alimenta os atalhos de `Processo` (grau, tribunal, classe,
  /// órgão julgador). Índice único parcial garante no máximo uma por processo.
  principal Boolean @default(false)

  ultimaSincronizacao DateTime? @map("ultima_sincronizacao")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  processo      Processo                 @relation(fields: [processoId], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoProcessual[]
  comunicacoes  ComunicacaoDjen[]

  @@unique([processoId, docId])
  @@index([processoId])
  @@map("processos_instancias")
}

/// Cadastro de PARTE EXTERNA — quem não é filiado nem usuário do sistema: a
/// empresa ré (PRONTOCARE), o município, uma autarquia, uma pessoa física, e
/// também o PRÓPRIO SINDICATO quando é ele quem propõe a ação coletiva.
///
/// POR QUE UM CADASTRO, E NÃO TEXTO SOLTO NA PARTE: é o que permite responder
/// perguntas institucionais que o sindicato faz o tempo todo — "quantas ações
/// temos contra a PRONTOCARE?", "qual o valor total em causa contra o
/// Município?". Com o nome digitado à mão em cada processo ("Prontocare",
/// "PRONTO CARE LTDA", "Pronto-Care") isso é impossível.
///
/// POR QUE NÃO REAPROVEITAR `empresas`: aquela tabela tem outra semântica — é a
/// EMPREGADORA dos colaboradores do sindicato (FK obrigatória em `colaboradores`).
/// Uma empresa ré cairia no seletor de empresa do RH. São cadastros diferentes.
///
/// O cadastro é OPCIONAL: a parte pode ficar só com o nome digitado
/// (`ParteProcesso.nome`) e ser promovida a cadastro depois, sem retrabalho.
model ParteExterna {
  id            String           @id @default(uuid())
  tipo          TipoParteExterna
  /// Razão social (PJ) ou nome completo (PF).
  nome          String
  nomeFantasia  String?          @map("nome_fantasia")
  /// CPF/CNPJ apenas com dígitos. Único quando informado (índice parcial no SQL),
  /// nulo quando a parte é conhecida só pelo nome.
  documento     String?
  email         String?
  telefone      String?
  cidade        String?
  uf            String?
  observacoes   String?
  ativo         Boolean          @default(true)
  /// Marca a parte que É o próprio sindicato, usada como polo ativo das ações
  /// institucionais. Existe uma só (índice único parcial na migração).
  ///
  /// Por que uma flag e não um id fixo no código: a secretaria pode corrigir
  /// razão social e CNPJ pela tela de Partes sem que nada quebre — o back
  /// procura por `institucional: true`, não por um UUID chumbado.
  institucional Boolean          @default(false)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  participacoes ParteProcesso[]
  /// Filiados que trabalham nesta organização. A mesma entidade serve de
  /// EMPREGADOR e de PARTE em processo — no sindicato, o hospital que emprega
  /// é com frequência o mesmo que é réu.
  vinculos      VinculoProfissional[]

  @@index([tipo])
  @@index([ativo])
  @@map("partes_externas")
}

/// PARTE DO PROCESSO — uma linha por parte, em um polo.
///
/// O DataJud NÃO resolve isso: a API Pública do CNJ devolve apenas metadados
/// processuais (classe, assunto, órgão, movimentos). Verificado nos índices de
/// TJPI, TRT22, TJSP e TRF1: o `_source` não tem `partes`, `poloAtivo` nem
/// `advogados` — é uma decisão do CNJ por LGPD, não uma limitação do parser.
/// Logo, as partes são um dado NOSSO, preenchido pela equipe.
///
/// IDENTIDADE EM CAMADAS: `nome` é SEMPRE gravado (snapshot de como a parte
/// consta nos autos) e `filiadoId`/`parteExternaId` são enriquecimentos
/// opcionais e MUTUAMENTE EXCLUSIVOS (CHECK no banco). Assim, apagar um filiado
/// ou um cadastro de parte externa não apaga a história do processo: o vínculo
/// vira nulo e o nome dos autos permanece.
model ParteProcesso {
  id         String       @id @default(uuid())
  processoId String       @map("processo_id")
  polo       PoloProcesso
  /// Papel como consta nos autos (Reclamante, Reclamada, Autor, Réu, Exequente,
  /// Substituído, Terceiro Interessado…). Texto livre porque a nomenclatura muda
  /// conforme a justiça — o front sugere as opções mais comuns por polo.
  papel      String?
  /// Parte principal do polo: é o par que aparece como "Autor × Réu" na lista e
  /// o que define o filiado principal do processo.
  principal  Boolean      @default(false)

  /// Nome como consta nos autos — obrigatório e sempre preenchido (snapshot).
  nome      String
  /// CPF/CNPJ como consta nos autos (só dígitos), quando conhecido.
  documento String?

  /// Enriquecimentos opcionais e mutuamente exclusivos (ver CHECK na migração).
  filiadoId      String? @map("filiado_id")
  parteExternaId String? @map("parte_externa_id")

  /// Advogados da parte adversa informados pela equipe ([{nome, oab}]).
  advogados  Json?
  observacao String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  processo     Processo      @relation(fields: [processoId], references: [id], onDelete: Cascade)
  filiado      Filiado?      @relation(fields: [filiadoId], references: [id], onDelete: SetNull)
  parteExterna ParteExterna? @relation(fields: [parteExternaId], references: [id], onDelete: SetNull)

  @@index([processoId, polo])
  @@index([filiadoId])
  @@index([parteExternaId])
  @@map("partes_processo")
}

/// Advogado da CASA que atua no processo (N:N com `users`).
///
/// Separado de `ParteProcesso` de propósito: advogado do sindicato não é parte —
/// é responsável interno. É o que alimenta "meus processos", a distribuição de
/// carteira e a escala. `principal` marca o responsável (no máximo um por
/// processo, garantido por índice único parcial na migração).
model ProcessoAdvogado {
  processoId String   @map("processo_id")
  advogadoId String   @map("advogado_id")
  principal  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  processo Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  advogado User     @relation("ProcessoAdvogadoEquipe", fields: [advogadoId], references: [id], onDelete: Cascade)

  @@id([processoId, advogadoId])
  @@index([advogadoId])
  @@map("processos_advogados")
}

/// Anexo (documento/laudo) vinculado a um Atendimento (triagem), a um Processo
/// OU a uma atividade da Agenda.
/// LGPD (art. 6º, VII): o arquivo é guardado por chave opaca no storage e servido
/// apenas por URL controlada pela API (local) ou assinada e temporária (S3),
/// nunca por caminho público adivinhável.
///
/// REAPROVEITAMENTO ("puxar documento"): o filiado entrega o mesmo laudo/RG várias
/// vezes ao longo do ano. Em vez de exigir novo upload a cada atendimento, a
/// equipe PUXA um documento já existente do acervo do filiado: cria-se uma nova
/// linha aqui apontando para a MESMA `storage_key` (arquivo único no bucket) e
/// registrando de onde veio (`origem_anexo_id` ou `origem_documento_id`).
/// Consequência importante: a exclusão só apaga o arquivo do storage quando
/// nenhuma outra linha (aqui ou em `documentos`) ainda usa aquela chave.
model AnexoDocumento {
  id           String @id @default(uuid())
  storageKey   String @map("storage_key") // chave opaca no bucket (fonte de verdade)
  url          String // URL de acesso (pública controlada no local; assinada no S3)
  nomeArquivo  String @map("nome_arquivo")
  tipoMime     String @map("tipo_mime")
  tamanhoBytes Int?   @map("tamanho_bytes")

  // Vínculo polimórfico (exatamente um preenchido)
  atendimentoId String? @map("atendimento_id")
  processoId    String? @map("processo_id")
  /// Atividade da agenda (audiência, diligência, consulta) dona do documento.
  compromissoId String? @map("compromisso_id")

  /// Procedência quando o anexo foi PUXADO do acervo do filiado (não houve
  /// upload). SetNull: apagar a origem não apaga a cópia já vinculada aqui.
  origemAnexoId     String? @map("origem_anexo_id")
  origemDocumentoId String? @map("origem_documento_id")

  createdAt DateTime @default(now()) @map("created_at")

  atendimento     Atendimento?          @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  processo        Processo?             @relation(fields: [processoId], references: [id], onDelete: Cascade)
  compromisso     Compromisso?          @relation(fields: [compromissoId], references: [id], onDelete: Cascade)
  origemAnexo     AnexoDocumento?       @relation("AnexoReaproveitado", fields: [origemAnexoId], references: [id], onDelete: SetNull)
  reaproveitados  AnexoDocumento[]      @relation("AnexoReaproveitado")
  origemDocumento Documento?            @relation(fields: [origemDocumentoId], references: [id], onDelete: SetNull)
  /// Movimentações internas que citam este anexo (SetNull do outro lado).
  movimentacoes   MovimentacaoInterna[]

  @@index([atendimentoId])
  @@index([processoId])
  @@index([compromissoId])
  @@index([storageKey])
  @@map("anexos_documentos")
}

/// Movimentação processual (andamento) espelhada do DATAJUD.
///
/// RADAR DE AUDIÊNCIAS: as colunas `eh_audiencia`/`audiencia_data` são gravadas
/// na importação e na sincronização (classificador em utils/audiencia.util.ts).
/// Elas alimentam o alerta "Audiências a Agendar" do dashboard — por isso o
/// estado do alerta (dispensa / evento criado) mora AQUI, no banco local, e não
/// na sessão do navegador: a varredura noturna precisa respeitá-lo.
model MovimentacaoProcessual {
  id          String  @id @default(uuid())
  processoId  String  @map("processo_id")
  /// De QUAL grau veio este andamento.
  ///
  /// Nulo no histórico anterior à tabela de instâncias (o backfill aponta tudo
  /// para a instância principal, mas movimentações gravadas antes de o processo
  /// ter instância continuam soltas) e em processos sem NPU. A timeline sabe
  /// lidar com isso: sem instância, o andamento aparece sem etiqueta de grau.
  instanciaId String? @map("instancia_id")

  dataMovimento   DateTime @map("data_movimento")
  descricao       String
  codigoMovimento Int?     @map("codigo_movimento")
  createdAt       DateTime @default(now()) @map("created_at")

  // ---- Detalhamento do ato (para o advogado não precisar abrir o PJe) ----
  /// `complementosTabelados` cru: [{codigo, descricao, valor, nome}].
  complementos  Json?
  /// Rótulo derivado dos complementos — o "— Contestação" de
  /// "Petição — Contestação". Precomputado na escrita para a leitura ser barata.
  detalhe       String?
  /// Síntese/teor do ato quando o tribunal envia (`conteudo`/`descricao`).
  conteudo      String?
  /// Órgão julgador que praticou o ato (pode diferir do órgão atual do processo).
  orgaoJulgador String? @map("orgao_julgador")

  /// Movimentação é DESIGNAÇÃO/REDESIGNAÇÃO de audiência (código TPU + texto)?
  ehAudiencia      Boolean   @default(false) @map("eh_audiencia")
  /// Data/hora da audiência extraída do TEXTO da movimentação (null se não veio).
  audienciaData    DateTime? @map("audiencia_data")
  /// Compromisso criado a partir do alerta. `SetNull` de propósito: se o evento
  /// for excluído da agenda, a audiência volta a aparecer como pendente.
  compromissoId    String?   @map("compromisso_id")
  /// Dispensa do alerta ("não é audiência" / "já agendado fora do sistema").
  dispensadoEm     DateTime? @map("dispensado_em")
  dispensadoPor    String?   @map("dispensado_por") // id do usuário (ver Auditoria)
  dispensadoMotivo String?   @map("dispensado_motivo")

  processo     Processo           @relation(fields: [processoId], references: [id], onDelete: Cascade)
  /// SetNull: apagar/recriar a instância não pode levar junto o histórico de
  /// andamentos, que é o dado caro desta tabela.
  instancia    ProcessoInstancia? @relation(fields: [instanciaId], references: [id], onDelete: SetNull)
  compromisso  Compromisso?       @relation(fields: [compromissoId], references: [id], onDelete: SetNull)
  /// Publicações do DJEN que descrevem o mesmo fato deste andamento.
  comunicacoes ComunicacaoDjen[]

  @@index([processoId])
  @@index([instanciaId])
  @@index([dataMovimento])
  /// Deduplicação: a chave inclui `detalhe` porque o CNJ devolve, no mesmo
  /// instante e com o mesmo código, a designação E o cancelamento da audiência
  /// (verificado no TRT22). O índice único vive na migração
  /// 20260807200000_dedup_com_detalhe, com COALESCE — o Prisma não expressa
  /// índice sobre expressão.
  /// "Última movimentação" da lista: WHERE processo_id = ? ORDER BY data DESC LIMIT 1.
  @@index([processoId, dataMovimento(sort: Desc)])
  /// Filtro por fase processual (códigos de início de execução — ver fase.util.ts).
  @@index([codigoMovimento, processoId])
  // Suporta a consulta do radar: pendentes = eh_audiencia AND dispensado IS NULL.
  @@index([ehAudiencia, dispensadoEm])
  @@index([compromissoId])
  @@map("movimentacoes_processuais")
}

/// PUBLICAÇÃO/INTIMAÇÃO do DJEN (API Comunica PJe, do CNJ).
///
/// POR QUE EXISTE
/// O DataJud entrega o RÓTULO do ato ("Expedição de documento", "Mero
/// expediente") e quase nunca o teor. Quem abre prazo é a publicação, e é ela
/// que diz o que fazer: "Intimo a parte autora a apresentar réplica no prazo de
/// 15 dias". Sem essa fonte, a atividade automática só podia dizer "confira no
/// PJe o que estão pedindo".
///
/// A tabela COMPLEMENTA as movimentações — não as substitui. O DataJud continua
/// sendo quem detecta que algo aconteceu; o DJEN explica o quê.
///
/// LGPD: ao contrário do DataJud (só metadado), `texto` traz NOME DAS PARTES no
/// corpo. É publicação oficial, pública por lei, mas a natureza do dado mudou:
/// o teor nunca vai para log de aplicação e a leitura passa pelo mesmo controle
/// de módulo do resto de Processos.
model ComunicacaoDjen {
  id String @id @default(uuid())

  /// Hash da comunicação no DJEN. Chave natural e ÚNICA.
  ///
  /// É a idempotência que falta ao lado DataJud: aqui a duplicata é impossível
  /// por constraint do banco, não por acordo em memória. Reprocessar a mesma
  /// janela de dias — o que a varredura faz todo dia, de propósito — é
  /// inofensivo.
  hash String @unique

  /// NPU com 20 dígitos, como o DJEN devolve (idêntico ao do DataJud).
  numeroProcesso String  @map("numero_processo")
  /// Processo local. NUNCA nulo na prática: publicação de processo não
  /// cadastrado é descartada na ingestão, por decisão de produto. Opcional no
  /// schema para o vínculo sobreviver à exclusão do processo.
  processoId     String? @map("processo_id")
  /// Instância inferida pelo órgão julgador. Nulo quando não casa — não bloqueia.
  instanciaId    String? @map("instancia_id")
  siglaTribunal  String  @map("sigla_tribunal")

  /// Intimação | Edital | Citação | Lista de distribuição. São 4 valores limpos
  /// e é sobre eles que as regras são escritas.
  tipoComunicacao String? @map("tipo_comunicacao")
  /// TEXTO LIVRE, varia por tribunal ("Sentença", "87", "DESPACHO/DECISÃO",
  /// "Devedores"). Guardado para exibição; NÃO usar em regra de classificação.
  tipoDocumento   String? @map("tipo_documento")
  nomeOrgao       String? @map("nome_orgao")
  nomeClasse      String? @map("nome_classe")
  /// D = Diário de Justiça Eletrônico Nacional; E = Plataforma de Editais.
  meio            String?
  /// Link para o documento no sistema do tribunal.
  link            String?
  /// Teor integral da publicação — o dado que justifica a integração inteira.
  texto           String

  dataDisponibilizacao DateTime @map("data_disponibilizacao") @db.Date

  /// Partes destinatárias [{nome, polo}] como o DJEN envia.
  destinatarios Json?
  /// Advogados intimados [{nome, numero_oab, uf_oab}].
  advogados     Json?

  /// Providência classificada a partir do texto (ver utils/providencia.util.ts).
  providencia         String?
  /// Prazo em dias que o TEXTO menciona. É SUGESTÃO — nunca vira vencimento
  /// calculado; serve para antecipar o lembrete e alertar quem for conferir.
  prazoMencionadoDias Int?    @map("prazo_mencionado_dias")

  /// Atividade criada ou enriquecida por esta publicação.
  compromissoId  String? @map("compromisso_id")
  /// Movimentação do DataJud que descreve o MESMO fato. É o vínculo que impede
  /// as duas fontes de gerarem duas atividades para um ato só.
  movimentacaoId String? @map("movimentacao_id")

  createdAt DateTime @default(now()) @map("created_at")

  processo     Processo?               @relation(fields: [processoId], references: [id], onDelete: Cascade)
  instancia    ProcessoInstancia?      @relation(fields: [instanciaId], references: [id], onDelete: SetNull)
  compromisso  Compromisso?            @relation(fields: [compromissoId], references: [id], onDelete: SetNull)
  movimentacao MovimentacaoProcessual? @relation(fields: [movimentacaoId], references: [id], onDelete: SetNull)

  @@index([processoId, dataDisponibilizacao])
  @@index([numeroProcesso])
  @@index([compromissoId])
  @@index([movimentacaoId])
  @@map("comunicacoes_djen")
}

/// De onde partiu a chamada ao DataJud (as ÚNICAS três permitidas).
enum OrigemSincronizacao {
  IMPORTACAO // cadastro do processo
  MANUAL // botão "Sincronizar DataJud" no detalhe
  CRON // varredura noturna
}

/// Log de cada chamada ao DataJud — dá visibilidade ao que o robô fez de
/// madrugada e guarda o motivo das falhas (rate limit, tribunal fora do ar…).
/// LGPD: registra só metadado público (NPU, tribunal) e a mensagem técnica.
model LogSincronizacaoDatajud {
  id         String  @id @default(uuid())
  processoId String? @map("processo_id")
  numeroCNJ  String  @map("numero_cnj")
  tribunal   String?
  /// QUAL API foi chamada: "DATAJUD" ou "DJEN".
  ///
  /// Texto e não enum de propósito: `origem` (abaixo) já é um enum e responde
  /// outra pergunta — QUEM disparou (importação, botão, robô). Somar uma fonte
  /// nova a um enum custa migração; aqui vão nascer outras (tribunais
  /// superiores, MNI) e o default preserva todas as linhas já gravadas.
  fonte      String  @default("DATAJUD")

  origem             OrigemSincronizacao
  sucesso            Boolean
  httpStatus         Int?                @map("http_status")
  mensagemErro       String?             @map("mensagem_erro")
  /// Registros novos gravados nesta chamada — movimentações (DATAJUD) ou
  /// publicações (DJEN). O nome ficou por compatibilidade com o histórico.
  novasMovimentacoes Int                 @default(0) @map("novas_movimentacoes")
  duracaoMs          Int?                @map("duracao_ms")
  createdAt          DateTime            @default(now()) @map("created_at")

  processo Processo? @relation(fields: [processoId], references: [id], onDelete: SetNull)

  @@index([processoId])
  @@index([createdAt])
  @@index([sucesso, createdAt])
  @@index([fonte, createdAt])
  @@map("logs_sincronizacao_datajud")
}

/// Trava de execução única dos jobs agendados (ver common/utils/trava-job.util.ts).
///
/// Uma linha por job, com prazo. Existe porque a trava anterior era um booleano
/// em memória: com mais de uma réplica da API, as duas rodavam a varredura ao
/// mesmo tempo, dobrando as chamadas ao CNJ e duplicando movimentação.
model TravaJob {
  /// Nome do job ("datajud-sync", "djen-sync"). Chave primária: é o que garante
  /// que só exista uma trava por job.
  nome     String   @id
  /// Instância da API que a detém — impede que uma réplica libere a trava de outra.
  donoId   String   @map("dono_id")
  /// Depois disto a trava é considerada abandonada e pode ser tomada. É o que
  /// torna a trava à prova de queda do processo, sem intervenção manual.
  expiraEm DateTime @map("expira_em")

  @@map("travas_job")
}

/// Tipo de movimentação interna (andamento) — CADASTRÁVEL, mesma ideia dos tipos
/// de evento da Agenda. Os tipos "sistema" são semeados na migração e não podem
/// ser excluídos, só renomeados/recoloridos/ocultados.
/// (Nome "TipoAndamento" para não colidir com o enum TipoMovimentacao do
/// financeiro; a tabela continua sendo `tipos_movimentacao`.)
model TipoAndamento {
  id        String   @id @default(uuid())
  slug      String   @unique
  nome      String
  cor       String   @default("slate")
  ordem     Int      @default(0)
  ativo     Boolean  @default(true)
  sistema   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tipos_movimentacao")
}

/// Movimentação registrada MANUALMENTE pela equipe jurídica (andamento interno).
///
/// Fica em tabela SEPARADA de `MovimentacaoProcessual` de propósito: aquela é um
/// espelho fiel do DataJud (recriável e sujeito à varredura noturna/radar), esta
/// é conteúdo produzido pelo escritório — tem autor, anexo, nota interna e pode
/// carimbar a mudança de status do processo. Misturar as duas tornaria o cache
/// do CNJ dono de dados que não são dele. A "linha do tempo" da tela é a UNIÃO
/// das duas fontes, ordenada por data.
model MovimentacaoInterna {
  id             String          @id @default(uuid())
  processoId     String          @map("processo_id")
  /// Slug de TipoMovimentacao (cadastrável).
  tipo           String
  descricao      String
  /// DATA DO FATO — quando o ato REALMENTE aconteceu, se diferente do registro.
  ///
  /// Sem isto, a audiência de quarta lançada na sexta apareceria na sexta e a
  /// linha do tempo mentiria. A ordenação da timeline usa `dataFato ?? createdAt`;
  /// `createdAt` continua intocado como carimbo de auditoria ("registrado em"),
  /// e a tela mostra os dois quando divergem.
  dataFato       DateTime?       @map("data_fato")
  /// Nota interna: não deve ser exibida ao filiado em relatórios/extratos.
  notaInterna    Boolean         @default(false) @map("nota_interna")
  /// Carimbo da mudança de status feita JUNTO com esta movimentação (auditoria).
  statusAnterior StatusProcesso? @map("status_anterior")
  statusNovo     StatusProcesso? @map("status_novo")
  /// Documento anexado no ato do registro (também aparece na aba Documentos).
  anexoId        String?         @map("anexo_id")
  /// Autor do registro. SetNull: excluir o usuário não apaga o histórico.
  autorId        String?         @map("autor_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  processo Processo        @relation(fields: [processoId], references: [id], onDelete: Cascade)
  autor    User?           @relation("MovimentacaoAutor", fields: [autorId], references: [id], onDelete: SetNull)
  anexo    AnexoDocumento? @relation(fields: [anexoId], references: [id], onDelete: SetNull)

  @@index([processoId, createdAt])
  // Ordenação da timeline pela data do FATO (quando informada).
  @@index([processoId, dataFato])
  @@index([tipo])
  @@map("movimentacoes_internas")
}

/// Situação da contribuição patronal declarada pela empresa no portal.
enum StatusContribuicaoPatronal {
  /// Guia gerada; aguardando o PIX e o envio dos documentos.
  AGUARDANDO
  /// Documentos enviados; aguardando conferência do sindicato.
  EM_ANALISE
  /// Conferida e aceita.
  HOMOLOGADA
  /// Recusada — a empresa precisa corrigir e declarar de novo.
  REJEITADA
}

/// Contribuição patronal declarada pela empresa no Portal.
///
/// O fluxo é: a empresa declara mês e valor (AGUARDANDO) → paga o PIX e anexa
/// o comprovante mais a relação de trabalhadores (EM_ANALISE) → o sindicato
/// confere (HOMOLOGADA ou REJEITADA).
///
/// LGPD: a relação de trabalhadores contém dados pessoais de terceiros. Por
/// isso os arquivos NÃO ficam públicos — as colunas guardam a CHAVE no storage
/// e a API devolve uma URL assinada de curta duração a cada leitura.
model ContribuicaoPatronal {
  id             String  @id @default(uuid())
  empresaId      String  @map("empresa_id")
  /// Competência no formato AAAA-MM (ex.: "2026-07") — ordena como texto.
  mesReferencia  String  @map("mes_referencia")
  /// Valor informado pela empresa; a conferência do sindicato é manual.
  valorDeclarado Decimal @map("valor_declarado") @db.Decimal(12, 2)

  status StatusContribuicaoPatronal @default(AGUARDANDO)

  /// Chaves no storage (ver nota de LGPD acima).
  urlComprovantePix       String? @map("url_comprovante_pix")
  urlRelacaoTrabalhadores String? @map("url_relacao_trabalhadores")

  /// Momento em que os documentos entraram (início da análise).
  enviadoEm DateTime? @map("enviado_em")

  // --- Conferência pelo sindicato ---
  /// Obrigatório na rejeição: é o que a empresa lê para saber o que corrigir.
  motivoRejeicao String?   @map("motivo_rejeicao")
  analisadoEm    DateTime? @map("analisado_em")
  /// Quem homologou/rejeitou. SetNull: excluir o usuário não apaga a trilha.
  analisadoPor   String?   @map("analisado_por")
  /// Lançamento no fluxo de caixa gerado pela homologação.
  /// @unique impede lançar o mesmo valor duas vezes.
  movimentacaoId String?   @unique @map("movimentacao_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  analista     User?         @relation("ContribuicaoAnalista", fields: [analisadoPor], references: [id], onDelete: SetNull)
  movimentacao Movimentacao? @relation(fields: [movimentacaoId], references: [id], onDelete: SetNull)

  @@index([empresaId, mesReferencia])
  @@index([status])
  @@map("contribuicoes_patronais")
}

/// O que aconteceu com uma atividade, em ordem.
///
/// A Auditoria global registra tudo, mas é do sistema inteiro e não serve para
/// mostrar ao usuário "o que houve com ESTE compromisso". Esta tabela é a linha
/// do tempo exibida no detalhe da atividade.
model CompromissoHistorico {
  id            String   @id @default(uuid())
  compromissoId String   @map("compromisso_id")
  /// CRIADO | EDITADO | INICIADO | CONCLUIDO | CANCELADO | REMARCADO | REABERTO
  acao          String
  /// Frase pronta para a tela ("Concluída — Houve acordo").
  descricao     String
  /// Nome de quem fez, congelado: se o usuário for excluído, a linha continua legível.
  autorNome     String?  @map("autor_nome")
  autorId       String?  @map("autor_id")
  /// Detalhes estruturados (status anterior, datas da remarcação, motivo…).
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at")

  compromisso Compromisso @relation(fields: [compromissoId], references: [id], onDelete: Cascade)
  autor       User?       @relation("CompromissoHistoricoAutor", fields: [autorId], references: [id], onDelete: SetNull)

  @@index([compromissoId, createdAt])
  @@map("compromissos_historico")
}

/// Julgamento humano sobre um par de filiados que a varredura apontou como
/// possível duplicata.
///
/// Guarda a DECISÃO, não o grupo: a detecção é recalculada a cada varredura a
/// partir dos dados atuais, e uma lista de grupos persistida envelheceria
/// sozinha assim que alguém corrigisse um nome. O que precisa sobreviver é
/// "olhei estes dois e resolvi X" — para o par não voltar a ser perguntado.
///
/// NÃO tem relação com Filiado de propósito: numa fusão o descartado é
/// apagado, e uma FK em cascata destruiria o registro da fusão no instante em
/// que ele passa a ser a única memória daquele cadastro.
model DuplicataDecisao {
  id         String           @id @default(uuid())
  /// Par sempre normalizado com A < B — sem isso, (X,Y) e (Y,X) escapariam do
  /// índice único e o mesmo par poderia ser julgado duas vezes.
  filiadoIdA String           @map("filiado_id_a")
  filiadoIdB String           @map("filiado_id_b")
  decisao    DecisaoDuplicata
  /// Snapshot do nome de quem decidiu; sobrevive à exclusão do usuário.
  autor      String?
  /// Na fusão: o que foi absorvido e os dados do registro apagado.
  metadata   Json?
  createdAt  DateTime         @default(now()) @map("created_at")

  @@unique([filiadoIdA, filiadoIdB], map: "duplicata_decisao_par_key")
  @@index([filiadoIdA], map: "duplicata_decisao_a_idx")
  @@index([filiadoIdB], map: "duplicata_decisao_b_idx")
  @@map("duplicata_decisao")
}

enum DecisaoDuplicata {
  /// Revisado e são pessoas diferentes — nunca mais perguntar.
  DISTINTOS
  /// Fundidos: os dados foram consolidados no mantido e o outro, apagado.
  FUNDIDO
}

/// A identidade visual DESTA instalação, editável pela tela.
///
/// A paleta e os logos nasceram em arquivo (`tenant.config.ts` e `/public`), o
/// que exigia programador e deploy para trocar a cor de um sindicato. Aqui eles
/// passam a ser dado — e o arquivo continua sendo o PADRÃO, usado enquanto
/// ninguém mexeu e como rede de segurança se o banco estiver fora do ar.
///
/// LINHA ÚNICA, com id fixo. Não é uma tabela de configurações genérica: cada
/// banco é de um sindicato só, então "a identidade" é uma coisa só. Um id fixo
/// torna a gravação um `upsert` trivial e impede duas linhas concorrentes.
model IdentidadeVisual {
  id String @id @default("unica")

  /// Cor institucional escolhida, em hexadecimal (#RRGGBB). Os dez tons da
  /// escala são DERIVADOS dela na tela — guardar os dez aqui deixaria o banco
  /// e o algoritmo saírem de sincronia na primeira melhoria do algoritmo.
  corPrimaria String? @map("cor_primaria")

  /// Chaves no storage. Nulo = usa o arquivo de `/public`, pelo nome do tenant.
  logoHorizontalCorKey    String? @map("logo_horizontal_cor_key")
  logoHorizontalBrancoKey String? @map("logo_horizontal_branco_key")
  logoVerticalCorKey      String? @map("logo_vertical_cor_key")
  logoVerticalBrancoKey   String? @map("logo_vertical_branco_key")
  /// Ícone da aba do navegador e do app instalado (PWA). Quadrado.
  iconeKey                String? @map("icone_key")

  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  /// Snapshot do nome de quem mexeu; sobrevive à exclusão do usuário.
  atualizadoPor String?  @map("atualizado_por")

  @@map("identidade_visual")
}
