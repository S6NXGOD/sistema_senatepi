# ==========================================================================
# SENATEPI — variáveis de ambiente (copie para .env e preencha)
# NUNCA faça commit do .env preenchido. No Railway, defina estas variáveis
# no painel de cada serviço (nada de segredos no repositório).
# ==========================================================================

# ┌────────────────────────────────────────────────────────────────────────┐
# │ SERVIÇO API (NestJS) — apps/api                                        │
# └────────────────────────────────────────────────────────────────────────┘

# ---- Banco de dados (PostgreSQL) ----
# No Railway, use a referência do plugin Postgres: ${{ Postgres.DATABASE_URL }}
DATABASE_URL=

# ---- Autenticação (JWT) ----
# Gere segredos fortes e ÚNICOS em produção: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=30d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=60d

# Segredo para assinar os tokens dos QR Codes (HMAC) — gere um valor forte.
QR_SIGNING_SECRET=

# Segredo do PORTAL PATRONAL (login das empresas conveniadas).
# Se ficar vazio, o sistema DERIVA um segredo próprio a partir do JWT da equipe
# — nunca reaproveita o mesmo, para que um token de empresa jamais seja aceito
# como token de usuário do sindicato. Ainda assim, defina um valor próprio em
# produção: derivar é uma rede de segurança, não a configuração desejada.
JWT_EMPRESA_SECRET=
JWT_EMPRESA_EXPIRES_IN=8h

# ---- Integração DATAJUD (CNJ) ----
# Chave da API Pública do DATAJUD. O CNJ publica uma chave ÚNICA e compartilhada
# para a API pública (não é um segredo privado); o código já traz esse valor como
# padrão. Defina aqui apenas se o CNJ rotacionar a chave pública.
DATAJUD_API_KEY=

# ---- Usuário administrador padrão (criado só no PRIMEIRO deploy) ----
SEED_ADMIN_EMAIL=admin@senatepi.org.br
# Defina uma senha forte ANTES do primeiro deploy. Se vazio, usa um padrão inseguro.
SEED_ADMIN_PASSWORD=

# ---- Armazenamento de arquivos (fotos de perfil, anexos, documentos) ----
# Driver: "local" (grava em disco e serve pela API) ou "s3" (MinIO/AWS).
# ATENÇÃO (Railway): o disco do container é EFÊMERO — arquivos enviados somem a
# cada deploy/restart, a menos que STORAGE_LOCAL_DIR aponte para dentro de um
# VOLUME montado. Em produção, monte um Volume (ex.: em /data) e use
# STORAGE_LOCAL_DIR=/data/uploads, OU use STORAGE_DRIVER=s3 (recomendado).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# URL pública onde a API serve os uploads (ex.: https://sua-api.up.railway.app)
STORAGE_PUBLIC_URL=
# Abaixo: usados apenas quando STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=senatepi
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# ---- API ----
ASSETS_DIR=./assets
# O Railway injeta PORT automaticamente; API_PORT é o fallback local.
API_PORT=3333
API_PREFIX=api
NODE_ENV=production
# Origens permitidas para CORS (separadas por vírgula) — inclua o domínio do front.
CORS_ORIGINS=http://localhost:3000

# URL PÚBLICA DO FRONT — usada para montar o link de recadastramento enviado ao
# filiado (validade de 24h). Sem ela, o sistema cai na primeira entrada de
# CORS_ORIGINS; se aquela for a URL da API, o link chega quebrado no WhatsApp.
# Defina explicitamente em produção.
APP_PUBLIC_URL=http://localhost:3000
# Habilita a doc Swagger em /api/docs (desligada por padrão em produção).
SWAGGER_ENABLED=false

# ---- MUTIRÃO DE CADASTROS DUPLICADOS (temporário) ----
# Liga a tela que compara filiados possivelmente duplicados e permite
# consolidá-los. Existe para higienizar a carga legada — 70% dos filiados
# vieram sem CPF, e sem CPF o índice único não impede repetição.
#
# PADRÃO DESLIGADO, de propósito: é uma tela capaz de EXCLUIR filiados, e
# mantê-la ligada depois do mutirão é risco permanente em troca de utilidade
# temporária. Desligada, as rotas respondem 404 — guardar o link não adianta.
#
# Ligue durante o mutirão, desligue ao terminar. A tela também se esconde
# sozinha quando não há mais grupos pendentes.
# Aceita: true | 1 | on | sim
FILIADOS_DUPLICIDADE=false

# ┌────────────────────────────────────────────────────────────────────────┐
# │ SERVIÇO WEB (Next.js) — apps/web                                        │
# │ NEXT_PUBLIC_* são embutidas no BUILD: defina-as no build do serviço web │
# └────────────────────────────────────────────────────────────────────────┘

# URL pública da API (ex.: https://sua-api.up.railway.app/api)
NEXT_PUBLIC_API_URL=http://localhost:3333/api
NEXT_PUBLIC_APP_NAME=SENATEPI
